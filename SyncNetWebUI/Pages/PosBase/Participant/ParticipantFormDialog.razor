@inject LookupService LookupManagement

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">
                <MudIcon Icon="@Icons.Material.Filled.Business" />
            </MudAvatar>
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6">@(IsEdit ? "Edit Participant" : "Tambah Participant")</MudText>
                @if (IsEdit)
                {
                    <MudText Typo="Typo.caption" Style="opacity:.65">@_model.ParticipantId</MudText>
                }
            </MudStack>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="_model" Class="px-2">
            <MudTabs Elevation="0" Rounded="false" SliderColor="Color.Primary" TabPanelsClass="pa-6" Class="mt-2">
                <MudTabPanel Text="General" ToolTip="General" Icon="@Icons.Material.Filled.Info">
                    <MudGrid Spacing="5">
                        <MudItem xs="12" sm="6">
                            <MudTextField T="string" Label="Participant ID" @bind-Value="_model.ParticipantId"
                                          Disabled="@(IsEdit || _busy)" Required="true" RequiredError="Participant ID wajib diisi" MaxLength="15" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField T="string" Label="Participant Name" @bind-Value="_model.Name" MaxLength="50" Disabled="_busy" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField T="string" Label="Inst ID" @bind-Value="_model.InstId" MaxLength="15" Disabled="_busy" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect T="string" Label="Virtual Account" @bind-Value="_model.VirtualAccount" Disabled="_busy" Clearable="true"
                                       ToStringFunc="@(accNr => VaLabel(accNr))">
                                @foreach (var va in _vaAccounts)
                                {
                                    <MudSelectItem T="string" Value="@va.Key">@va.Value</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12">
                            <MudSwitch T="bool" Value="_model.Active" ValueChanged="@(v => _model.Active = v)" Color="Color.Success" Disabled="_busy">
                                @(_model.Active ? "Active" : "Not Active")
                            </MudSwitch>
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>

                <MudTabPanel Text="Address" ToolTip="Address" Icon="@Icons.Material.Filled.Place">
                    <MudGrid Spacing="5">
                        <MudItem xs="12" sm="6">
                            <MudTextField T="string" Label="Alamat" @bind-Value="_model.Address" MaxLength="50" Disabled="_busy" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudAutocomplete T="string" Label="Kota" @bind-Value="_model.City" SearchFunc="SearchCities"
                                             Disabled="_busy" Clearable="true"
                                             Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                             CoerceValue="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField T="string" Label="Kode Pos" @bind-Value="_model.Zipcode" MaxLength="5" Disabled="_busy" />
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>

                <MudTabPanel Text="Contact" ToolTip="Contact" Icon="@Icons.Material.Filled.ContactMail">
                    <MudGrid Spacing="5">
                        <MudItem xs="12" sm="6">
                            <MudTextField T="string" Label="PIC" @bind-Value="_model.Person" MaxLength="30" Disabled="_busy" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField T="string" Label="Telepon" @bind-Value="_model.Phone" MaxLength="30" Disabled="_busy" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField T="string" Label="Fax" @bind-Value="_model.Fax" MaxLength="30" Disabled="_busy" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField T="string" Label="Email" @bind-Value="_model.Email" InputType="InputType.Email" MaxLength="30" Disabled="_busy" />
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>
            </MudTabs>

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mt-2" Dense="true">@_error</MudAlert>
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_busy">Batal</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Simpan
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Inject] private ParticipantManagementService ParticipantManagement { get; set; } = null!;
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public ParticipantDto? Participant { get; set; }

    private MudForm _form = null!;
    private readonly FormModel _model = new();
    private bool _busy;
    private string? _error;
    private List<LookupItemDto> _cities = new();
    private List<LookupItemDto> _vaAccounts = new();

    protected override async Task OnInitializedAsync()
    {
        _cities = await LookupManagement.GetCitiesAsync() ?? new();
        _vaAccounts = await LookupManagement.GetVaAccountsAsync() ?? new();

        if (IsEdit && Participant != null)
        {
            _model.ParticipantId = Participant.ParticipantId;
            _model.InstId = Participant.InstId ?? string.Empty;
            _model.Name = Participant.Name ?? string.Empty;
            _model.Address = Participant.Address ?? string.Empty;
            _model.City = Participant.City ?? string.Empty;
            _model.Zipcode = Participant.Zipcode ?? string.Empty;
            _model.Person = Participant.Person ?? string.Empty;
            _model.Phone = Participant.Phone ?? string.Empty;
            _model.Fax = Participant.Fax ?? string.Empty;
            _model.Email = Participant.Email ?? string.Empty;
            _model.VirtualAccount = Participant.VirtualAccount ?? string.Empty;
            _model.VaName = Participant.VaName ?? string.Empty;
            _model.Active = Participant.Active;
        }
    }

    private Task<IEnumerable<string>> SearchCities(string value, CancellationToken ct)
    {
        var results = string.IsNullOrWhiteSpace(value)
            ? _cities.Select(c => c.Value)
            : _cities.Where(c => c.Value.Contains(value, StringComparison.OrdinalIgnoreCase)).Select(c => c.Value);
        return Task.FromResult(results.Take(20));
    }

    private string VaLabel(string? accNr) => _vaAccounts.FirstOrDefault(v => v.Key == accNr)?.Value ?? (accNr ?? string.Empty);

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        _busy = true;
        _error = null;
        // va_name is a display cache derived from the selected Virtual Account, matching
        // legacy's `model.va_name = dbService.VaAccountGetName(model.virtual_account)`.
        _model.VaName = _vaAccounts.FirstOrDefault(v => v.Key == _model.VirtualAccount)?.Value ?? string.Empty;

        if (IsEdit)
        {
            var request = new UpdateParticipantRequest
            {
                InstId = _model.InstId,
                Name = _model.Name,
                Address = _model.Address,
                City = _model.City,
                Zipcode = _model.Zipcode,
                Person = _model.Person,
                Phone = _model.Phone,
                Fax = _model.Fax,
                Email = _model.Email,
                VirtualAccount = _model.VirtualAccount,
                VaName = _model.VaName,
                Active = _model.Active
            };
            var (success, error) = await ParticipantManagement.UpdateParticipantAsync(_model.ParticipantId, request);
            _busy = false;

            if (success) { MudDialog.Close(DialogResult.Ok(true)); return; }
            _error = error ?? "Gagal menyimpan perubahan.";
        }
        else
        {
            var request = new CreateParticipantRequest
            {
                ParticipantId = _model.ParticipantId,
                InstId = _model.InstId,
                Name = _model.Name,
                Address = _model.Address,
                City = _model.City,
                Zipcode = _model.Zipcode,
                Person = _model.Person,
                Phone = _model.Phone,
                Fax = _model.Fax,
                Email = _model.Email,
                VirtualAccount = _model.VirtualAccount,
                VaName = _model.VaName,
                Active = _model.Active
            };
            var (success, _, error) = await ParticipantManagement.CreateParticipantAsync(request);
            _busy = false;

            if (success) { MudDialog.Close(DialogResult.Ok(true)); return; }
            _error = error ?? "Gagal menambahkan participant.";
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private class FormModel
    {
        public string ParticipantId { get; set; } = string.Empty;
        public string InstId { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string Address { get; set; } = string.Empty;
        public string City { get; set; } = string.Empty;
        public string Zipcode { get; set; } = string.Empty;
        public string Person { get; set; } = string.Empty;
        public string Phone { get; set; } = string.Empty;
        public string Fax { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string VirtualAccount { get; set; } = string.Empty;
        public string VaName { get; set; } = string.Empty;
        public bool Active { get; set; } = true;
    }
}
