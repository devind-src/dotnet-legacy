<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">
                <MudIcon Icon="@Icons.Material.Filled.Groups" />
            </MudAvatar>
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6">@(IsEdit ? "Edit Sub Merchant Group" : "Tambah Sub Merchant Group")</MudText>
                @if (IsEdit)
                {
                    <MudText Typo="Typo.caption" Style="opacity:.65">@_model.GroupName</MudText>
                }
            </MudStack>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="_model" Class="px-2 pt-4">
            <MudGrid Spacing="5">
                <MudItem xs="12">
                    <MudTextField T="string" Label="Sub Group Name" @bind-Value="_model.GroupName"
                                  Disabled="@(IsEdit || _busy)" Required="true" RequiredError="Sub group name wajib diisi" MaxLength="50" />
                </MudItem>
                <MudItem xs="12">
                    @if (IsEdit)
                    {
                        <MudTextField T="string" Label="Participant" Value="_model.ParticipantId" Disabled="true" />
                    }
                    else
                    {
                        <MudSelect T="string" Label="Participant" @bind-Value="_model.ParticipantId" Required="true" RequiredError="Participant wajib dipilih" Disabled="_busy">
                            @foreach (var p in Participants)
                            {
                                <MudSelectItem T="string" Value="@p.ParticipantId">@p.ParticipantId - @p.Name</MudSelectItem>
                            }
                        </MudSelect>
                    }
                </MudItem>
                <MudItem xs="12">
                    <MudSelect T="string" Label="Merchant Group" @bind-Value="_model.ParentGroupName" Required="true" RequiredError="Merchant group wajib dipilih" Disabled="_busy">
                        @foreach (var g in MerchantGroups)
                        {
                            <MudSelectItem T="string" Value="@g.GroupName">@g.GroupName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField T="string" Label="Catatan" @bind-Value="_model.Notes" MaxLength="50" Disabled="_busy" />
                </MudItem>
            </MudGrid>

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mt-4" Dense="true">@_error</MudAlert>
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_busy">Batal</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Simpan
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Inject] private SubMerchantGroupManagementService GroupManagement { get; set; } = null!;
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public List<ParticipantDto> Participants { get; set; } = new();
    [Parameter] public List<MerchantGroupDto> MerchantGroups { get; set; } = new();
    [Parameter] public SubMerchantGroupDto? Group { get; set; }

    private MudForm _form = null!;
    private readonly FormModel _model = new();
    private bool _busy;
    private string? _error;

    protected override void OnInitialized()
    {
        if (IsEdit && Group != null)
        {
            _model.GroupName = Group.GroupName;
            _model.ParticipantId = Group.ParticipantId ?? string.Empty;
            _model.ParentGroupName = Group.ParentGroupName ?? string.Empty;
            _model.Notes = Group.Notes ?? string.Empty;
        }
    }

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        _busy = true;
        _error = null;

        if (IsEdit)
        {
            var request = new UpdateSubMerchantGroupRequest { ParentGroupName = _model.ParentGroupName, Notes = _model.Notes };
            var (success, error) = await GroupManagement.UpdateGroupAsync(_model.GroupName, request);
            _busy = false;

            if (success) { MudDialog.Close(DialogResult.Ok(true)); return; }
            _error = error ?? "Gagal menyimpan perubahan.";
        }
        else
        {
            var request = new CreateSubMerchantGroupRequest
            {
                GroupName = _model.GroupName,
                ParticipantId = _model.ParticipantId,
                ParentGroupName = _model.ParentGroupName,
                Notes = _model.Notes
            };
            var (success, _, error) = await GroupManagement.CreateGroupAsync(request);
            _busy = false;

            if (success) { MudDialog.Close(DialogResult.Ok(true)); return; }
            _error = error ?? "Gagal menambahkan sub group.";
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private class FormModel
    {
        public string GroupName { get; set; } = string.Empty;
        public string ParticipantId { get; set; } = string.Empty;
        public string ParentGroupName { get; set; } = string.Empty;
        public string Notes { get; set; } = string.Empty;
    }
}
