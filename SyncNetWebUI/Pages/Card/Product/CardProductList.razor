@page "/card-product"
@attribute [Authorize]
@inject CardProductManagementService ProductManagement
@inject CardProductLimitManagementService LimitManagement
@inject CardIssuerManagementService IssuerManagement
@inject SessionState Session
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Product</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">Product</MudText>
<MudText Typo="Typo.body1" Style="opacity:.65" Class="mb-6">Card > Profile > Product.</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
        <MudTextField T="string" @bind-Value="_filter" Label="Cari product" Immediate="true"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      OnKeyDown="OnSearchKeyDown" Class="flex-grow-1" Style="max-width:320px;" />
        <MudStack Row="true" Spacing="2">
            <MudIconButton Icon="@Icons.Material.Filled.Search" OnClick="LoadAsync" title="Cari" />
            @if (Session.UserManagementPermissions.CanAdd)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenCreateDialog" Disabled="_issuers.Count == 0">Tambah Product</MudButton>
            }
        </MudStack>
    </MudStack>
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Class="mb-4" />
}
else if (_error != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}
else
{
    <MudTable Items="_items" Hover="true" Dense="true" Elevation="1" @bind-RowsPerPage="_rowsPerPage"
              T="CardProductDto" OnRowClick="@((TableRowClickEventArgs<CardProductDto> e) => SelectProductAsync(e.Item))">
        <HeaderContent>
            <MudTh>ID</MudTh>
            <MudTh>Issuer</MudTh>
            <MudTh>Product</MudTh>
            <MudTh>PAN Prefix</MudTh>
            <MudTh>PAN Length</MudTh>
            <MudTh>Card Type</MudTh>
            <MudTh>Profile Name</MudTh>
            <MudTh>Last Seq Number</MudTh>
            <MudTh>Aksi</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="ID">@context.Id</MudTd>
            <MudTd DataLabel="Issuer">@context.Issuer</MudTd>
            <MudTd DataLabel="Product">@context.Product</MudTd>
            <MudTd DataLabel="PAN Prefix">@context.PanPrefix</MudTd>
            <MudTd DataLabel="PAN Length">@context.PanLength</MudTd>
            <MudTd DataLabel="Card Type">@context.CardType</MudTd>
            <MudTd DataLabel="Profile Name">@context.ProfileName</MudTd>
            <MudTd DataLabel="Last Seq Number">@context.LastSeqNr</MudTd>
            <MudTd DataLabel="Aksi">
                @if (Session.UserManagementPermissions.CanEdit)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                   OnClick="@(() => OpenEditDialog(context))" title="Edit" />
                }
                @if (Session.UserManagementPermissions.CanDelete)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                   OnClick="@(() => ConfirmDeleteAsync(context))" title="Hapus" />
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Style="opacity:.65">Tidak ada product ditemukan.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 25, 50 }" />
        </PagerContent>
    </MudTable>

    @if (_selectedProduct != null)
    {
        <MudPaper Class="pa-4 mt-4" Elevation="1">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                <MudText Typo="Typo.h6" Color="Color.Primary">Limit — Product: @_selectedProduct.Product</MudText>
                @if (Session.UserManagementPermissions.CanAdd)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                               OnClick="OpenCreateLimitDialog">Tambah Limit</MudButton>
                }
            </MudStack>

            @if (_limitsLoading)
            {
                <MudProgressLinear Indeterminate="true" Class="mb-2" />
            }
            else
            {
                <MudTable Items="_limits" Hover="true" Dense="true" T="CardProductLimitDto">
                    <HeaderContent>
                        <MudTh>ID</MudTh>
                        <MudTh>Channel</MudTh>
                        <MudTh>Aksi</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="ID">@context.Id</MudTd>
                        <MudTd DataLabel="Channel">@CardChannelHelper.Label(context.Channel)</MudTd>
                        <MudTd DataLabel="Aksi">
                            @if (Session.UserManagementPermissions.CanEdit)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                               OnClick="@(() => OpenEditLimitDialog(context))" title="Edit" />
                            }
                            @if (Session.UserManagementPermissions.CanDelete)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                               OnClick="@(() => ConfirmDeleteLimitAsync(context))" title="Hapus" />
                            }
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Style="opacity:.65">Belum ada limit untuk product ini.</MudText>
                    </NoRecordsContent>
                </MudTable>
            }
        </MudPaper>
    }
}

@code {
    private List<CardProductDto> _items = new();
    private List<CardIssuerDto> _issuers = new();
    private string _filter = string.Empty;
    private bool _loading = true;
    private string? _error;
    private int _rowsPerPage = 10;
    private static readonly DialogOptions SmallDialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true };
    private static readonly DialogOptions LargeDialogOptions = new() { MaxWidth = MaxWidth.Large, FullWidth = true };

    private CardProductDto? _selectedProduct;
    private List<CardProductLimitDto> _limits = new();
    private bool _limitsLoading;

    protected override async Task OnInitializedAsync()
    {
        _issuers = await IssuerManagement.GetIssuersAsync() ?? new();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        var result = await ProductManagement.GetProductsAsync(_filter);
        if (result == null)
        {
            _error = "Gagal memuat daftar product.";
            _items = new();
        }
        else
        {
            _items = result;
        }

        _loading = false;
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadAsync();
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<CardProductFormDialog>
        {
            { x => x.IsEdit, false },
            { x => x.Issuers, _issuers }
        };
        var dialog = await DialogService.ShowAsync<CardProductFormDialog>("Tambah Product", parameters, SmallDialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Snackbar.Add("Product berhasil ditambahkan.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task OpenEditDialog(CardProductDto item)
    {
        var parameters = new DialogParameters<CardProductFormDialog>
        {
            { x => x.IsEdit, true },
            { x => x.Issuers, _issuers },
            { x => x.Product, item }
        };
        var dialog = await DialogService.ShowAsync<CardProductFormDialog>("Edit Product", parameters, SmallDialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Snackbar.Add("Perubahan product berhasil disimpan.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task ConfirmDeleteAsync(CardProductDto item)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Hapus Product",
            $"Yakin ingin menghapus product '{item.Product}'? Limit terkait akan ikut terhapus. Tindakan ini tidak bisa dibatalkan.",
            yesText: "Hapus", cancelText: "Batal");

        if (confirmed != true) return;

        var (success, error) = await ProductManagement.DeleteProductAsync(item.Id);
        if (success)
        {
            Snackbar.Add("Product berhasil dihapus.", Severity.Success);
            if (_selectedProduct?.Id == item.Id) _selectedProduct = null;
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(error ?? "Gagal menghapus product.", Severity.Error);
        }
    }

    private async Task SelectProductAsync(CardProductDto product)
    {
        _selectedProduct = product;
        await LoadLimitsAsync();
    }

    private async Task LoadLimitsAsync()
    {
        if (_selectedProduct == null) return;

        _limitsLoading = true;
        _limits = await LimitManagement.GetByProductIdAsync(_selectedProduct.Id) ?? new();
        _limitsLoading = false;
    }

    private async Task OpenCreateLimitDialog()
    {
        if (_selectedProduct == null) return;

        var parameters = new DialogParameters<CardProductLimitFormDialog>
        {
            { x => x.IsEdit, false },
            { x => x.ProductId, _selectedProduct.Id }
        };
        var dialog = await DialogService.ShowAsync<CardProductLimitFormDialog>("Tambah Limit", parameters, LargeDialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Snackbar.Add("Limit berhasil ditambahkan.", Severity.Success);
            await LoadLimitsAsync();
        }
    }

    private async Task OpenEditLimitDialog(CardProductLimitDto item)
    {
        if (_selectedProduct == null) return;

        var parameters = new DialogParameters<CardProductLimitFormDialog>
        {
            { x => x.IsEdit, true },
            { x => x.ProductId, _selectedProduct.Id },
            { x => x.Limit, item }
        };
        var dialog = await DialogService.ShowAsync<CardProductLimitFormDialog>("Edit Limit", parameters, LargeDialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Snackbar.Add("Perubahan limit berhasil disimpan.", Severity.Success);
            await LoadLimitsAsync();
        }
    }

    private async Task ConfirmDeleteLimitAsync(CardProductLimitDto item)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Hapus Limit",
            $"Yakin ingin menghapus limit channel '{CardChannelHelper.Label(item.Channel)}'? Tindakan ini tidak bisa dibatalkan.",
            yesText: "Hapus", cancelText: "Batal");

        if (confirmed != true) return;

        var (success, error) = await LimitManagement.DeleteLimitAsync(item.Id);
        if (success)
        {
            Snackbar.Add("Limit berhasil dihapus.", Severity.Success);
            await LoadLimitsAsync();
        }
        else
        {
            Snackbar.Add(error ?? "Gagal menghapus limit.", Severity.Error);
        }
    }
}
