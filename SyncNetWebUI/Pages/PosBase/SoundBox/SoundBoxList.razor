@page "/posbase-soundbox"
@attribute [Authorize]
@inject SoundBoxManagementService SoundBoxManagement
@inject LookupService LookupManagement
@inject MerchantGroupManagementService MerchantGroupManagement
@inject SubMerchantGroupManagementService SubMerchantGroupManagement
@inject SessionState Session
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>SoundBox</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">SoundBox</MudText>
<MudText Typo="Typo.body1" Style="opacity:.65" Class="mb-6">Kelola perangkat SoundBox QRIS.</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
        <MudTextField T="string" @bind-Value="_filter" Label="Cari soundbox" Immediate="true"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      OnKeyDown="OnSearchKeyDown" Class="flex-grow-1" Style="max-width:320px;" />
        <MudStack Row="true" Spacing="2">
            <MudIconButton Icon="@Icons.Material.Filled.Search" OnClick="LoadAsync" title="Cari" />
            @if (Session.UserManagementPermissions.CanAdd)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenCreateDialog">Tambah SoundBox</MudButton>
            }
        </MudStack>
    </MudStack>
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Class="mb-4" />
}
else if (_error != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}
else
{
    <MudTable Items="_items" Hover="true" Dense="true" Elevation="1" @bind-RowsPerPage="_rowsPerPage">
        <HeaderContent>
            <MudTh>NMID</MudTh>
            <MudTh>Store Name</MudTh>
            <MudTh>Kota</MudTh>
            <MudTh>Serial Number</MudTh>
            <MudTh>Provider</MudTh>
            <MudTh>Aksi</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="NMID">@context.Nmid</MudTd>
            <MudTd DataLabel="Store Name">@context.StoreName</MudTd>
            <MudTd DataLabel="Kota">@context.City</MudTd>
            <MudTd DataLabel="Serial Number">@context.SerialNumber</MudTd>
            <MudTd DataLabel="Provider">@context.Provider</MudTd>
            <MudTd DataLabel="Aksi">
                @if (Session.UserManagementPermissions.CanEdit)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                   OnClick="@(() => OpenEditDialog(context))" title="Edit" />
                }
                @if (Session.UserManagementPermissions.CanDelete)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                   OnClick="@(() => ConfirmDeleteAsync(context))" title="Hapus" />
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Style="opacity:.65">Tidak ada soundbox ditemukan.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 25, 50 }" />
        </PagerContent>
    </MudTable>
}

@code {
    private List<SoundBoxDto> _items = new();
    private List<LookupItemDto> _cities = new();
    private List<MerchantGroupDto> _groups = new();
    private List<SubMerchantGroupDto> _subGroups = new();
    private string _filter = string.Empty;
    private bool _loading = true;
    private string? _error;
    private int _rowsPerPage = 10;
    private static readonly DialogOptions WideDialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true };

    protected override async Task OnInitializedAsync()
    {
        _cities = await LookupManagement.GetCitiesAsync() ?? new();
        _groups = await MerchantGroupManagement.GetGroupsAsync() ?? new();
        _subGroups = await SubMerchantGroupManagement.GetGroupsAsync() ?? new();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        var result = await SoundBoxManagement.GetSoundBoxesAsync(_filter);
        if (result == null)
        {
            _error = "Gagal memuat daftar soundbox.";
            _items = new();
        }
        else
        {
            _items = result;
        }

        _loading = false;
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadAsync();
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<SoundBoxFormDialog>
        {
            { x => x.IsEdit, false },
            { x => x.Cities, _cities },
            { x => x.Groups, _groups },
            { x => x.SubGroups, _subGroups }
        };
        var dialog = await DialogService.ShowAsync<SoundBoxFormDialog>("Tambah SoundBox", parameters, WideDialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Snackbar.Add("SoundBox berhasil ditambahkan.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task OpenEditDialog(SoundBoxDto soundBox)
    {
        var parameters = new DialogParameters<SoundBoxFormDialog>
        {
            { x => x.IsEdit, true },
            { x => x.Cities, _cities },
            { x => x.Groups, _groups },
            { x => x.SubGroups, _subGroups },
            { x => x.SoundBox, soundBox }
        };
        var dialog = await DialogService.ShowAsync<SoundBoxFormDialog>("Edit SoundBox", parameters, WideDialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Snackbar.Add("Perubahan soundbox berhasil disimpan.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task ConfirmDeleteAsync(SoundBoxDto soundBox)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Hapus SoundBox",
            $"Yakin ingin menghapus soundbox '{soundBox.Nmid}'? Tindakan ini tidak bisa dibatalkan.",
            yesText: "Hapus", cancelText: "Batal");

        if (confirmed != true) return;

        var (success, error) = await SoundBoxManagement.DeleteSoundBoxAsync(soundBox.Nmid);
        if (success)
        {
            Snackbar.Add("SoundBox berhasil dihapus.", Severity.Success);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(error ?? "Gagal menghapus soundbox.", Severity.Error);
        }
    }
}
