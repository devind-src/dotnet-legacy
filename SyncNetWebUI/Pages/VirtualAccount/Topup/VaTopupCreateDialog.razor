<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">
                <MudIcon Icon="@Icons.Material.Filled.Calculate" />
            </MudAvatar>
            <MudText Typo="Typo.h6">Tambah Topup</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="_model" Class="px-2 pt-4">
            <MudGrid Spacing="5">
                <MudItem xs="12">
                    <MudSelect T="string" Label="Account Number" @bind-Value="_model.AccNr" @bind-Value:after="OnAccountChanged"
                               Required="true" RequiredError="Account number wajib dipilih" Disabled="_busy">
                        @foreach (var a in Accounts)
                        {
                            <MudSelectItem T="string" Value="@a.AccNr">@($"{a.AccNr} - {a.VaName}")</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField T="string" Label="Group Name" Value="_groupName" Disabled="true" ReadOnly="true" />
                </MudItem>
                <MudItem xs="12">
                    <MudNumericField T="long" Label="Amount Topup" @bind-Value="_model.Amount" Disabled="_busy" Min="1" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField T="string" Label="Notes" @bind-Value="_model.Description" Disabled="_busy"
                                  Required="true" RequiredError="Notes wajib diisi" MaxLength="50" />
                </MudItem>
            </MudGrid>

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mt-4" Dense="true">@_error</MudAlert>
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_busy">Batal</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Simpan
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Inject] private VaTransRequestManagementService RequestManagement { get; set; } = null!;
    [Parameter] public List<VaAccountDto> Accounts { get; set; } = new();

    private MudForm _form = null!;
    private readonly FormModel _model = new();
    private string? _groupName;
    private bool _busy;
    private string? _error;

    protected override void OnInitialized()
    {
        if (Accounts.Count > 0)
        {
            _model.AccNr = Accounts[0].AccNr;
            OnAccountChanged();
        }
    }

    private void OnAccountChanged()
    {
        _groupName = Accounts.FirstOrDefault(a => a.AccNr == _model.AccNr)?.GroupName;
    }

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid || _model.Amount <= 0)
        {
            _error = _model.Amount <= 0 ? "Amount topup mandatory" : null;
            return;
        }

        _busy = true;
        _error = null;

        var request = new CreateVaTopupRequest
        {
            AccNr = _model.AccNr,
            Amount = _model.Amount,
            Description = _model.Description
        };
        var (success, _, error) = await RequestManagement.CreateTopupAsync(request);
        _busy = false;

        if (success) { MudDialog.Close(DialogResult.Ok(true)); return; }
        _error = error ?? "Gagal mengajukan topup.";
    }

    private void Cancel() => MudDialog.Cancel();

    private class FormModel
    {
        public string AccNr { get; set; } = string.Empty;
        public long Amount { get; set; }
        public string Description { get; set; } = string.Empty;
    }
}
