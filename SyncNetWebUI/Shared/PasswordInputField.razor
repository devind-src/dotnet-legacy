@inject IJSRuntime JS
@inject ISnackbar Snackbar

<div class="d-flex align-center gap-1 @Class">
    <MudTextField T="string" Label="@Label" Value="@Value" ValueChanged="OnValueChanged"
                  InputType="@(_visible ? InputType.Text : InputType.Password)"
                  Required="@Required" RequiredError="@RequiredError" Validation="@Validation"
                  Disabled="@Disabled" Class="flex-grow-1" />

    @if (ShowGenerateButton)
    {
        <MudIconButton Icon="@Icons.Material.Filled.Casino" Size="Size.Small" OnClick="GenerateAsync"
                       Disabled="@Disabled" title="Generate Password" />
    }

    <MudIconButton Icon="@(_visible ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                   Size="Size.Small" OnClick="ToggleVisibility" Disabled="@Disabled" title="Tampilkan/Sembunyikan" />

    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" OnClick="CopyAsync"
                   Disabled="@(Disabled || string.IsNullOrEmpty(Value))" title="Salin" />
</div>

@code {
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Required { get; set; } = true;
    [Parameter] public string? RequiredError { get; set; }
    [Parameter] public Func<string, string?>? Validation { get; set; }
    [Parameter] public bool ShowGenerateButton { get; set; } = true;
    /// <summary>Fired with the freshly generated value — lets the parent form mirror it into
    /// a sibling Confirm Password field.</summary>
    [Parameter] public EventCallback<string> OnGenerated { get; set; }
    [Parameter] public string? Class { get; set; }

    private bool _visible;

    private async Task OnValueChanged(string value)
    {
        Value = value;
        await ValueChanged.InvokeAsync(value);
    }

    private void ToggleVisibility() => _visible = !_visible;

    private async Task GenerateAsync()
    {
        var generated = PasswordGenerator.Generate();
        Value = generated;
        _visible = true;
        await ValueChanged.InvokeAsync(generated);
        await OnGenerated.InvokeAsync(generated);
    }

    private async Task CopyAsync()
    {
        if (string.IsNullOrEmpty(Value)) return;

        await JS.InvokeVoidAsync("navigator.clipboard.writeText", Value);
        Snackbar.Add("Password disalin ke clipboard.", Severity.Info);
    }
}
