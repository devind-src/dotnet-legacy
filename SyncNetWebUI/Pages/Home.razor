    private bool _isRefreshing;

    public void Dispose()
    {
        Theme.Changed -= StateHasChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        Theme.Changed += StateHasChanged;
        await GetDashboardDataOne();
    }

    private async Task OnTabChanged(int index)
    {
        switch (index)
        {
            case 0:
                await GetDashboardDataOne();
                break;
            case 1:
                await GetDashboardDataTwo();
                break;
        }
    }

    private async Task RefreshData()
    {
        if (_isRefreshing) return;

        _isRefreshing = true;
        try
        {
            await Task.Delay(500);
            await GetDashboardDataOne();
        }
        finally
        {
            _isRefreshing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    #region Dashboard 1
    private Task GetDashboardDataOne()
    {
        GenerateDummyDashOne();
        return Task.CompletedTask;
    }

    private static string GetHealthColor(double health, double tps)
    {
        if (tps <= 0) return "var(--mud-palette-success)";
        if (health >= 95) return "var(--mud-palette-info)";
        if (health >= 60) return "var(--mud-palette-warning)";
        return "var(--mud-palette-error)";
    }

    private static string GetTrafficStatus(double val) => val > 100 ? "HIGH LOAD" : val > 0 ? "OPTIMAL" : "IDLE";
    private static string GetLatencyStatus(int ms) => ms == 0 ? "IDLE" : ms < 1000 ? "FAST" : ms < 3000 ? "NORMAL" : "SLOW";

    private void GenerateDummyDashOne()
    {
        var random = new Random();
        _dash1 = new DashOneModel
        {
            SystemHealth = Math.Round(95.0 + (random.NextDouble() * 5.0), 2),
            SuccessRate = Math.Round(98.0 + (random.NextDouble() * 2.0), 2),
            Tps = Math.Round(10.0 + (random.NextDouble() * 40.0), 1),
            AvgRespTime = random.Next(150, 450)
        };

        List<string> tranTypes = ["TRANSFER", "WITHDRAWAL", "PAYMENT", "INQUIRY"];
        List<string> respCodes = ["00", "00", "00", "00", "05", "68"];

        for (var i = 1; i <= 10; i++)
        {
            var requestTime = DateTime.Now.AddSeconds(-random.Next(5, 300));
            var delayMs = random.Next(100, 800);
            var responseTime = requestTime.AddMilliseconds(delayMs);

            _dash1.ListTopTen.Add(new TopTenTransaction
            {
                TerminalId = $"TID{random.Next(10000, 99999)}",
                TranType = tranTypes[random.Next(tranTypes.Count)],
                AmountTran = random.Next(1, 50) * 100000,
                RespCodeRsp = respCodes[random.Next(respCodes.Count)],
                TimeRequest = requestTime,
                TimeResponse = responseTime
            });
        }

        _dash1.ListTopTen = _dash1.ListTopTen.OrderByDescending(t => t.TimeRequest).ToList();

        List<string> serviceNames =
        [
            "Artajasa", "Rintis", "QRIS API Gateway", "Bank DKI", "Notification",
            "Biller Switch", "EDC Merchant", "Bank BJB", "Settlement", "Token Server"
        ];

        foreach (var name in serviceNames)
        {
            var nodeStatus = random.Next(0, 10) > 0 ? "1" : "0";

            _dash1.ListServices.Add(new ServiceStatus
            {
                NodeName = name,
                LastEcho = DateTime.Now.AddSeconds(-random.Next(1, 10)),
                Status = nodeStatus
            });
        }
    }
