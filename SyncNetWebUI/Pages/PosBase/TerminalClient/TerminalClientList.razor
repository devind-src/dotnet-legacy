@page "/posbase-client"
@attribute [Authorize]
@inject TerminalClientManagementService ClientManagement
@inject MerchantGroupManagementService GroupManagement
@inject SubMerchantGroupManagementService SubGroupManagement
@inject SessionState Session
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Credential</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">Credential</MudText>
<MudText Typo="Typo.body1" Style="opacity:.65" Class="mb-6">Kelola kredensial API client untuk integrasi terminal.</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
        <MudTextField T="string" @bind-Value="_filter" Label="Cari credential" Immediate="true"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      OnKeyDown="OnSearchKeyDown" Class="flex-grow-1" Style="max-width:320px;" />
        <MudStack Row="true" Spacing="2">
            <MudIconButton Icon="@Icons.Material.Filled.Search" OnClick="LoadAsync" title="Cari" />
            @if (Session.UserManagementPermissions.CanAdd)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenCreateDialog">Tambah Credential</MudButton>
            }
        </MudStack>
    </MudStack>
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Class="mb-4" />
}
else if (_error != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}
else
{
    <MudTable Items="_items" Hover="true" Dense="true" Elevation="1" @bind-RowsPerPage="_rowsPerPage">
        <HeaderContent>
            <MudTh>Client ID</MudTh>
            <MudTh>Nama</MudTh>
            <MudTh>Username</MudTh>
            <MudTh>Group</MudTh>
            <MudTh>Aksi</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Client ID">@context.ClientId</MudTd>
            <MudTd DataLabel="Nama">@context.ClientName</MudTd>
            <MudTd DataLabel="Username">@context.Username</MudTd>
            <MudTd DataLabel="Group">@context.GroupName</MudTd>
            <MudTd DataLabel="Aksi">
                @if (Session.UserManagementPermissions.CanEdit)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                   OnClick="@(() => OpenEditDialog(context))" title="Edit" />
                }
                @if (Session.UserManagementPermissions.CanDelete)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                   OnClick="@(() => ConfirmDeleteAsync(context))" title="Hapus" />
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Style="opacity:.65">Tidak ada credential ditemukan.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 25, 50 }" />
        </PagerContent>
    </MudTable>
}

@code {
    private List<TerminalClientDto> _items = new();
    private List<MerchantGroupDto> _groups = new();
    private List<SubMerchantGroupDto> _subgroups = new();
    private string _filter = string.Empty;
    private bool _loading = true;
    private string? _error;
    private int _rowsPerPage = 10;
    private static readonly DialogOptions WideDialogOptions = new() { MaxWidth = MaxWidth.Large, FullWidth = true };

    protected override async Task OnInitializedAsync()
    {
        _groups = await GroupManagement.GetGroupsAsync() ?? new();
        _subgroups = await SubGroupManagement.GetGroupsAsync() ?? new();

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        var result = await ClientManagement.GetClientsAsync(_filter);
        if (result == null)
        {
            _error = "Gagal memuat daftar credential.";
            _items = new();
        }
        else
        {
            _items = result;
        }

        _loading = false;
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadAsync();
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<TerminalClientFormDialog>
        {
            { x => x.IsEdit, false },
            { x => x.Groups, _groups },
            { x => x.Subgroups, _subgroups }
        };
        var dialog = await DialogService.ShowAsync<TerminalClientFormDialog>("Tambah Credential", parameters, WideDialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Snackbar.Add("Credential berhasil ditambahkan.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task OpenEditDialog(TerminalClientDto client)
    {
        var parameters = new DialogParameters<TerminalClientFormDialog>
        {
            { x => x.IsEdit, true },
            { x => x.Client, client },
            { x => x.Groups, _groups },
            { x => x.Subgroups, _subgroups }
        };
        var dialog = await DialogService.ShowAsync<TerminalClientFormDialog>("Edit Credential", parameters, WideDialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Snackbar.Add("Perubahan credential berhasil disimpan.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task ConfirmDeleteAsync(TerminalClientDto client)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Hapus Credential",
            $"Yakin ingin menghapus credential '{client.ClientId}'? Tindakan ini tidak bisa dibatalkan.",
            yesText: "Hapus", cancelText: "Batal");

        if (confirmed != true) return;

        var (success, error) = await ClientManagement.DeleteClientAsync(client.ClientId);
        if (success)
        {
            Snackbar.Add("Credential berhasil dihapus.", Severity.Success);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(error ?? "Gagal menghapus credential.", Severity.Error);
        }
    }
}
