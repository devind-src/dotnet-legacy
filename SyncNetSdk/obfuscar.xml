<?xml version="1.0" encoding="utf-8" ?>
<Obfuscator>
	<!-- Path input/output -->
	<Var name="InPath" value="bin\Release\net10.0" />
	<Var name="OutPath" value="bin\Obfuscated" />
	<Var name="AssemblyName" value="SyncNetSdk" />
	
	<!-- Module otomatis sesuai nama project -->
	<Module file="$(InPath)\$(AssemblyName).dll">
		<Rename enable="true" />
		<StringEncryption enable="true" />
	</Module>

	<!-- Opsi yang defaultnya perlu diubah -->
	<Var name="KeepPublicApi" value="true" />
	<Var name="KeepTypeNames" value="true" />
	<Var name="KeepMemberNames" value="true" />

	<Var name="HidePrivateApi" value="true" />
	<Var name="HideStrings" value="true" />

	<Var name="RenameProperties" value="true" />
	<Var name="RenameFields" value="true" />
	
	<Var name="SuppressLog" value="true" />
	<Var name="EncryptStrings" value="true" />
</Obfuscator>