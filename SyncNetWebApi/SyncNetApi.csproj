<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SyncNetApi</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <UserSecretsId>syncnet-api-secrets</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Database -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- Auth: JWT Bearer + modern token handling -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.22.0" />

    <!-- OpenAPI (native .NET) + modern interactive docs UI -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Request/response DTOs — shared with any client (see SyncNetWasm) so they never
         drift out of sync with what this API actually accepts/returns. -->
    <ProjectReference Include="..\SyncNetApi.Contracts\SyncNetApi.Contracts.csproj" />
  </ItemGroup>

</Project>
