@inject UserManagementService UserManagement

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Reset Password</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-4">
            Reset password untuk user <b>@UserName</b>. Tindakan ini akan memaksa user
            mengganti password saat login berikutnya dan mengeluarkan (logout) semua sesi
            aktif user tersebut.
        </MudText>

        <MudForm @ref="_form" Model="_model">
            <PasswordInputField Label="Password Baru" @bind-Value="_model.NewPassword"
                                Required="true" RequiredError="Password baru wajib diisi"
                                Validation="@ValidatePassword" Disabled="_busy"
                                OnGenerated="@(pwd => _model.ConfirmPassword = pwd)" />

            <PasswordInputField Label="Konfirmasi Password Baru" @bind-Value="_model.ConfirmPassword"
                                Required="true" RequiredError="Konfirmasi password wajib diisi"
                                Validation="@ValidateConfirmPassword" Disabled="_busy"
                                ShowGenerateButton="false" />
        </MudForm>

        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mt-4" Dense="true">@_error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_busy">Batal</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Reset Password
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public string UserName { get; set; } = string.Empty;

    private MudForm _form = null!;
    private readonly FormModel _model = new();
    private bool _busy;
    private string? _error;

    private static string? ValidatePassword(string password) =>
        !string.IsNullOrEmpty(password) && password.Length >= 8 ? null : "Password minimal 8 karakter";

    private string? ValidateConfirmPassword(string confirmPassword) =>
        confirmPassword != _model.NewPassword ? "Tidak sama dengan password baru" : null;

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        _busy = true;
        _error = null;

        var (success, error) = await UserManagement.ResetPasswordAsync(UserName, _model.NewPassword);
        _busy = false;

        if (success) { MudDialog.Close(DialogResult.Ok(true)); return; }
        _error = error ?? "Gagal mereset password.";
    }

    private void Cancel() => MudDialog.Cancel();

    private class FormModel
    {
        public string NewPassword { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
