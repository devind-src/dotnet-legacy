<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">
                <MudIcon Icon="@Icons.Material.Filled.AltRoute" />
            </MudAvatar>
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6">@(IsEdit ? "Edit Route by Source" : "Tambah Route by Source")</MudText>
                @if (IsEdit)
                {
                    <MudText Typo="Typo.caption" Style="opacity:.65">ID @Route?.Id</MudText>
                }
            </MudStack>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="_model" Class="px-2 pt-4">
            <MudGrid Spacing="5">
                <MudItem xs="12">
                    <MudSelect T="int" Label="Sumber (Node Merchant)" @bind-Value="_model.NodeIdIn"
                               Disabled="@(IsEdit || _busy)" Required="true" RequiredError="Sumber wajib dipilih">
                        @foreach (var n in SourceNodes)
                        {
                            <MudSelectItem T="int" Value="@n.NodeId">@n.NodeName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudSelect T="int" Label="Tujuan (Node Biller)" @bind-Value="_model.NodeIdOut"
                               Disabled="@(IsEdit || _busy)" Required="true" RequiredError="Tujuan wajib dipilih">
                        @foreach (var n in DestinationNodes)
                        {
                            <MudSelectItem T="int" Value="@n.NodeId">@n.NodeName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudAutocomplete T="string" Label="Product ID" @bind-Value="_model.InstId"
                                     SearchFunc="SearchProducts" ToStringFunc="FormatProduct" ResetValueOnEmptyText="true" CoerceValue="true"
                                     Disabled="_busy" MaxLength="30" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField T="string" Label="Notes" @bind-Value="_model.Notes"
                                  Disabled="_busy" Required="true" RequiredError="Notes wajib diisi" MaxLength="50" />
                </MudItem>
            </MudGrid>

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mt-4" Dense="true">@_error</MudAlert>
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_busy">Batal</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Simpan
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Inject] private RouteSourceManagementService RouteSourceManagement { get; set; } = null!;
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public RouteSourceDto? Route { get; set; }
    [Parameter] public List<NodeDto> Nodes { get; set; } = new();
    [Parameter] public List<LookupItemDto> Products { get; set; } = new();

    private MudForm _form = null!;
    private readonly FormModel _model = new();
    private bool _busy;
    private string? _error;

    // Mirrors legacy NodeGetNodeMerchant/NodeGetNodeBiller filters (category "1" = Merchant,
    // "0"/"2" = Both/Biller-Issuer) — see PROJECT_TECHNICAL_SUMMARY.md §7.11.1.
    private IEnumerable<NodeDto> SourceNodes => Nodes.Where(n => n.Category == "1");
    private IEnumerable<NodeDto> DestinationNodes => Nodes.Where(n => n.Category is "0" or "2");

    protected override void OnInitialized()
    {
        if (IsEdit && Route != null)
        {
            _model.NodeIdIn = Route.NodeIdIn;
            _model.NodeIdOut = Route.NodeIdOut;
            _model.InstId = Route.InstId;
            _model.Notes = Route.Notes ?? string.Empty;
        }
        else
        {
            // MudSelect<int> has no natural "unselected" state — default to the first
            // option, same pattern as SupportMemberFormDialog's Team dropdown.
            _model.NodeIdIn = SourceNodes.FirstOrDefault()?.NodeId ?? 0;
            _model.NodeIdOut = DestinationNodes.FirstOrDefault()?.NodeId ?? 0;
        }
    }

    private Task<IEnumerable<string>> SearchProducts(string? value, CancellationToken ct)
    {
        var matches = string.IsNullOrWhiteSpace(value)
            ? Products.Select(p => p.Key)
            : Products.Where(p => p.Key.Contains(value, StringComparison.OrdinalIgnoreCase)
                                   || p.Value.Contains(value, StringComparison.OrdinalIgnoreCase))
                      .Select(p => p.Key);
        return Task.FromResult(matches);
    }

    private string? FormatProduct(string? code)
    {
        if (string.IsNullOrEmpty(code)) return code;
        var match = Products.FirstOrDefault(p => p.Key == code);
        return match == null ? code : $"{match.Key} — {match.Value}";
    }

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        _busy = true;
        _error = null;

        if (IsEdit && Route != null)
        {
            var request = new UpdateRouteSourceRequest { InstId = _model.InstId, Notes = _model.Notes };
            var (success, error) = await RouteSourceManagement.UpdateRouteAsync(Route.Id, request);
            _busy = false;

            if (success) { MudDialog.Close(DialogResult.Ok(true)); return; }
            _error = error ?? "Gagal menyimpan perubahan.";
        }
        else
        {
            var request = new CreateRouteSourceRequest { NodeIdIn = _model.NodeIdIn, NodeIdOut = _model.NodeIdOut, InstId = _model.InstId, Notes = _model.Notes };
            var (success, _, error) = await RouteSourceManagement.CreateRouteAsync(request);
            _busy = false;

            if (success) { MudDialog.Close(DialogResult.Ok(true)); return; }
            _error = error ?? "Gagal menambahkan route.";
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private class FormModel
    {
        public int NodeIdIn { get; set; }
        public int NodeIdOut { get; set; }
        public string? InstId { get; set; }
        public string Notes { get; set; } = string.Empty;
    }
}
