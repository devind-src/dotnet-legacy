@page "/cashout/account/miniatm"
@attribute [Authorize]
@inject CashoutMiniAtmManagementService MiniAtmManagement
@inject MerchantGroupManagementService MerchantGroupManagement
@inject SubMerchantGroupManagementService SubMerchantGroupManagement
@inject BankManagementService BankManagement
@inject SessionState Session
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Cashout Account Mini ATM</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">Cashout Account Mini ATM</MudText>
<MudText Typo="Typo.body1" Style="opacity:.65" Class="mb-6">Cashout Account &gt; Fee Mini ATM.</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
        <MudTextField T="string" @bind-Value="_filter" Label="Cari group / bank" Immediate="true"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      OnKeyDown="OnSearchKeyDown" Class="flex-grow-1" Style="max-width:320px;" />
        <MudStack Row="true" Spacing="2">
            <MudIconButton Icon="@Icons.Material.Filled.Search" OnClick="LoadAsync" title="Cari" />
            @if (Session.UserManagementPermissions.CanAdd)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenCreateDialog">Tambah Mini ATM Account</MudButton>
            }
        </MudStack>
    </MudStack>
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Class="mb-4" />
}
else if (_error != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}
else
{
    <MudTable Items="_items" Hover="true" Dense="true" Elevation="1" @bind-RowsPerPage="_rowsPerPage">
        <HeaderContent>
            <MudTh>Group Name</MudTh>
            <MudTh>Bank Name</MudTh>
            <MudTh>Bank Code</MudTh>
            <MudTh>Account Number</MudTh>
            <MudTh>Account Name</MudTh>
            <MudTh>Aksi</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Group Name">@context.GroupName</MudTd>
            <MudTd DataLabel="Bank Name">@context.BankName</MudTd>
            <MudTd DataLabel="Bank Code">@context.BankCode</MudTd>
            <MudTd DataLabel="Account Number">@context.AccNumber</MudTd>
            <MudTd DataLabel="Account Name">@context.AccName</MudTd>
            <MudTd DataLabel="Aksi">
                @if (Session.UserManagementPermissions.CanEdit)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                   OnClick="@(() => OpenEditDialog(context))" title="Edit" />
                }
                @if (Session.UserManagementPermissions.CanDelete)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                   OnClick="@(() => ConfirmDeleteAsync(context))" title="Hapus" />
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Style="opacity:.65">Tidak ada cashout mini ATM account ditemukan.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 25, 50 }" />
        </PagerContent>
    </MudTable>
}

@code {
    private List<CashoutMiniAtmDto> _items = new();
    private List<LookupItemDto> _groups = new();
    private List<BankDto> _banks = new();
    private string _filter = string.Empty;
    private bool _loading = true;
    private string? _error;
    private int _rowsPerPage = 10;
    private static readonly DialogOptions NarrowDialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true };

    protected override async Task OnInitializedAsync()
    {
        var merchantGroups = await MerchantGroupManagement.GetGroupsAsync();
        var subMerchantGroups = await SubMerchantGroupManagement.GetGroupsAsync();
        _groups = (merchantGroups ?? new()).Select(g => g.GroupName)
            .Union((subMerchantGroups ?? new()).Select(g => g.GroupName))
            .Select(g => new LookupItemDto(g, g))
            .ToList();

        _banks = await BankManagement.GetBanksAsync() ?? new();

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        var result = await MiniAtmManagement.GetRecordsAsync(_filter);
        if (result == null)
        {
            _error = "Gagal memuat daftar cashout mini ATM account.";
            _items = new();
        }
        else
        {
            _items = result;
        }

        _loading = false;
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadAsync();
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<CashoutMiniAtmFormDialog>
        {
            { x => x.IsEdit, false },
            { x => x.Groups, _groups },
            { x => x.Banks, _banks }
        };
        var dialog = await DialogService.ShowAsync<CashoutMiniAtmFormDialog>("Tambah Mini ATM Account", parameters, NarrowDialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Snackbar.Add("Cashout mini ATM account berhasil ditambahkan.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task OpenEditDialog(CashoutMiniAtmDto item)
    {
        var parameters = new DialogParameters<CashoutMiniAtmFormDialog>
        {
            { x => x.IsEdit, true },
            { x => x.Item, item },
            { x => x.Groups, _groups },
            { x => x.Banks, _banks }
        };
        var dialog = await DialogService.ShowAsync<CashoutMiniAtmFormDialog>("Edit Mini ATM Account", parameters, NarrowDialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Snackbar.Add("Perubahan cashout mini ATM account berhasil disimpan.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task ConfirmDeleteAsync(CashoutMiniAtmDto item)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Hapus Mini ATM Account",
            $"Yakin ingin menghapus cashout mini ATM account untuk group '{item.GroupName}'? Tindakan ini tidak bisa dibatalkan.",
            yesText: "Hapus", cancelText: "Batal");

        if (confirmed != true) return;

        var (success, error) = await MiniAtmManagement.DeleteAsync(item.Id);
        if (success)
        {
            Snackbar.Add("Cashout mini ATM account berhasil dihapus.", Severity.Success);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(error ?? "Gagal menghapus cashout mini ATM account.", Severity.Error);
        }
    }
}
