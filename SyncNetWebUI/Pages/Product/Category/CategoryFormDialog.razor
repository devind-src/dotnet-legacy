<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">
                <MudIcon Icon="@Icons.Material.Filled.Category" />
            </MudAvatar>
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6">@(IsEdit ? "Edit Category" : "Tambah Category")</MudText>
                @if (IsEdit)
                {
                    <MudText Typo="Typo.caption" Style="opacity:.65">@Category?.Category</MudText>
                }
            </MudStack>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="_model" Class="px-2 pt-4">
            <MudGrid Spacing="5">
                <MudItem xs="12">
                    <MudTextField T="string" Label="Category" @bind-Value="_model.Category"
                                  Disabled="@(IsEdit || _busy)" Required="true" RequiredError="Category wajib diisi" MaxLength="30" />
                </MudItem>
                <MudItem xs="12">
                    <MudSwitch T="bool" Value="_model.IsTopup" ValueChanged="@(v => _model.IsTopup = v)" Color="Color.Primary" Disabled="_busy">
                        @(_model.IsTopup ? "Topup" : "Bukan Topup")
                    </MudSwitch>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField T="string" Label="Notes" @bind-Value="_model.Notes"
                                  Disabled="_busy" Required="true" RequiredError="Notes wajib diisi" MaxLength="50" />
                </MudItem>
            </MudGrid>

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mt-4" Dense="true">@_error</MudAlert>
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_busy">Batal</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Simpan
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Inject] private ProductCategoryManagementService CategoryManagement { get; set; } = null!;
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public ProductCategoryDto? Category { get; set; }

    private MudForm _form = null!;
    private readonly FormModel _model = new();
    private bool _busy;
    private string? _error;

    protected override void OnInitialized()
    {
        if (IsEdit && Category != null)
        {
            _model.Category = Category.Category;
            _model.IsTopup = Category.IsTopup;
            _model.Notes = Category.Notes ?? string.Empty;
        }
    }

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        _busy = true;
        _error = null;

        if (IsEdit && Category != null)
        {
            var request = new UpdateProductCategoryRequest { IsTopup = _model.IsTopup, Notes = _model.Notes };
            var (success, error) = await CategoryManagement.UpdateCategoryAsync(Category.Category, request);
            _busy = false;

            if (success) { MudDialog.Close(DialogResult.Ok(true)); return; }
            _error = error ?? "Gagal menyimpan perubahan.";
        }
        else
        {
            var request = new CreateProductCategoryRequest { Category = _model.Category, IsTopup = _model.IsTopup, Notes = _model.Notes };
            var (success, _, error) = await CategoryManagement.CreateCategoryAsync(request);
            _busy = false;

            if (success) { MudDialog.Close(DialogResult.Ok(true)); return; }
            _error = error ?? "Gagal menambahkan category.";
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private class FormModel
    {
        public string Category { get; set; } = string.Empty;
        public bool IsTopup { get; set; }
        public string Notes { get; set; } = string.Empty;
    }
}
