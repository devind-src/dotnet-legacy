<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">
                <MudIcon Icon="@Icons.Material.Filled.LocationCity" />
            </MudAvatar>
            <MudText Typo="Typo.h6">@(IsEdit ? "Edit City" : "Tambah City")</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="_model" Class="px-2 pt-4">
            <MudGrid Spacing="5">
                <MudItem xs="12">
                    <MudTextField T="string" Label="City" @bind-Value="_model.City"
                                  Disabled="_busy" Required="true" RequiredError="City wajib diisi" MaxLength="50" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField T="string" Label="Province" @bind-Value="_model.Province" Disabled="_busy" MaxLength="50" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField T="string" Label="City Type" @bind-Value="_model.CityType" Disabled="_busy" MaxLength="1" />
                </MudItem>
            </MudGrid>

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mt-4" Dense="true">@_error</MudAlert>
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_busy">Batal</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Simpan
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Inject] private CityManagementService CityManagement { get; set; } = null!;
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public CityDto? City { get; set; }

    private MudForm _form = null!;
    private readonly FormModel _model = new();
    private bool _busy;
    private string? _error;

    protected override void OnInitialized()
    {
        if (IsEdit && City != null)
        {
            _model.Id = City.Id;
            _model.City = City.City ?? string.Empty;
            _model.Province = City.Province;
            _model.CityType = City.CityType;
        }
    }

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        _busy = true;
        _error = null;

        if (IsEdit)
        {
            var (success, error) = await CityManagement.UpdateCityAsync(_model.Id, new UpdateCityRequest
            {
                City = _model.City,
                Province = _model.Province,
                CityType = _model.CityType
            });
            _busy = false;

            if (success) { MudDialog.Close(DialogResult.Ok(true)); return; }
            _error = error ?? "Gagal menyimpan perubahan.";
        }
        else
        {
            var request = new CreateCityRequest
            {
                City = _model.City,
                Province = _model.Province,
                CityType = _model.CityType
            };
            var (success, _, error) = await CityManagement.CreateCityAsync(request);
            _busy = false;

            if (success) { MudDialog.Close(DialogResult.Ok(true)); return; }
            _error = error ?? "Gagal menambahkan city.";
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private class FormModel
    {
        public long Id { get; set; }
        public string City { get; set; } = string.Empty;
        public string? Province { get; set; }
        public string? CityType { get; set; }
    }
}
