@page "/route-product"
@attribute [Authorize]
@inject RouteProductManagementService RouteProductManagement
@inject NodeManagementService NodeManagement
@inject LookupService Lookups
@inject SessionState Session
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Route by Product</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">Route by Product</MudText>
<MudText Typo="Typo.body1" Style="opacity:.65" Class="mb-6">Routing > Product.</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
        <MudTextField T="string" @bind-Value="_filter" Label="Cari product ID / notes" Immediate="true"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      OnKeyDown="OnSearchKeyDown" Class="flex-grow-1" Style="max-width:320px;" />
        <MudStack Row="true" Spacing="2">
            <MudIconButton Icon="@Icons.Material.Filled.Search" OnClick="LoadAsync" title="Cari" />
            @if (Session.UserManagementPermissions.CanAdd)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenCreateDialog">Tambah Route</MudButton>
            }
        </MudStack>
    </MudStack>
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Class="mb-4" />
}
else if (_error != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}
else
{
    <MudTable Items="_items" Hover="true" Dense="true" Elevation="1" @bind-RowsPerPage="_rowsPerPage">
        <HeaderContent>
            <MudTh>Product ID</MudTh>
            <MudTh>Node</MudTh>
            <MudTh>Notes</MudTh>
            <MudTh>Aksi</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Product ID">@context.InstId</MudTd>
            <MudTd DataLabel="Node">@NodeName(context.NodeId)</MudTd>
            <MudTd DataLabel="Notes">@context.Notes</MudTd>
            <MudTd DataLabel="Aksi">
                @if (Session.UserManagementPermissions.CanEdit)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                   OnClick="@(() => OpenEditDialog(context))" title="Edit" />
                }
                @if (Session.UserManagementPermissions.CanDelete)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                   OnClick="@(() => ConfirmDeleteAsync(context))" title="Hapus" />
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Style="opacity:.65">Tidak ada route ditemukan.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 25, 50 }" />
        </PagerContent>
    </MudTable>
}

@code {
    private List<RouteProductDto> _items = new();
    private List<NodeDto> _nodes = new();
    private List<LookupItemDto> _availableProducts = new();
    private string _filter = string.Empty;
    private bool _loading = true;
    private string? _error;
    private int _rowsPerPage = 10;
    private static readonly DialogOptions WideDialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true };

    protected override async Task OnInitializedAsync()
    {
        var nodes = await NodeManagement.GetNodesAsync();
        _nodes = nodes ?? new();

        var products = await Lookups.GetProductsAvailableForRoutingAsync();
        _availableProducts = products ?? new();

        await LoadAsync();
    }

    private string NodeName(int nodeId) => _nodes.FirstOrDefault(n => n.NodeId == nodeId)?.NodeName ?? nodeId.ToString();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        var result = await RouteProductManagement.GetRoutesAsync(_filter);
        if (result == null)
        {
            _error = "Gagal memuat daftar route.";
            _items = new();
        }
        else
        {
            _items = result;
        }

        _loading = false;
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadAsync();
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<RouteProductFormDialog>
        {
            { x => x.IsEdit, false },
            { x => x.Nodes, _nodes },
            { x => x.AvailableProducts, _availableProducts }
        };
        var dialog = await DialogService.ShowAsync<RouteProductFormDialog>("Tambah Route by Product", parameters, WideDialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Snackbar.Add("Route berhasil ditambahkan.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task OpenEditDialog(RouteProductDto item)
    {
        var parameters = new DialogParameters<RouteProductFormDialog>
        {
            { x => x.IsEdit, true },
            { x => x.Route, item },
            { x => x.Nodes, _nodes },
            { x => x.AvailableProducts, _availableProducts }
        };
        var dialog = await DialogService.ShowAsync<RouteProductFormDialog>("Edit Route by Product", parameters, WideDialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Snackbar.Add("Perubahan route berhasil disimpan.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task ConfirmDeleteAsync(RouteProductDto item)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Hapus Route",
            $"Yakin ingin menghapus route untuk product '{item.InstId}'? Tindakan ini tidak bisa dibatalkan.",
            yesText: "Hapus", cancelText: "Batal");

        if (confirmed != true) return;

        var (success, error) = await RouteProductManagement.DeleteRouteAsync(item.InstId);
        if (success)
        {
            Snackbar.Add("Route berhasil dihapus.", Severity.Success);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(error ?? "Gagal menghapus route.", Severity.Error);
        }
    }
}
