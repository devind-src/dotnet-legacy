@page "/va-adjustment"
@attribute [Authorize]
@inject VaTransRequestManagementService RequestManagement
@inject VaAccountManagementService AccountManagement
@inject SessionState Session
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Adjustment</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">Adjustment</MudText>
<MudText Typo="Typo.body1" Style="opacity:.65" Class="mb-6">Virtual Account > Adjustment.</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
        <MudTextField T="string" @bind-Value="_filter" Label="Cari adjustment" Immediate="true"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      OnKeyDown="OnSearchKeyDown" Class="flex-grow-1" Style="max-width:320px;" />
        <MudStack Row="true" Spacing="2">
            <MudIconButton Icon="@Icons.Material.Filled.Search" OnClick="LoadAsync" title="Cari" />
            @if (Session.UserManagementPermissions.CanAdd)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenCreateDialog" Disabled="_accounts.Count == 0">Tambah Adjustment</MudButton>
            }
        </MudStack>
    </MudStack>
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Class="mb-4" />
}
else if (_error != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}
else
{
    <MudTable Items="_items" Hover="true" Dense="true" Elevation="1" @bind-RowsPerPage="_rowsPerPage">
        <HeaderContent>
            <MudTh></MudTh>
            <MudTh>Tran Number</MudTh>
            <MudTh>Account Number</MudTh>
            <MudTh>VA Name</MudTh>
            <MudTh>Notes</MudTh>
            <MudTh>D/C</MudTh>
            <MudTh>Amount</MudTh>
            <MudTh>Requested By</MudTh>
            <MudTh>Requested Date</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Aksi</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd><MudIcon Icon="@Icons.Material.Filled.Circle" Size="Size.Small" Color="@StatusColor(context.Status)" /></MudTd>
            <MudTd DataLabel="Tran Number">@context.TranNr</MudTd>
            <MudTd DataLabel="Account Number">@context.AccNr</MudTd>
            <MudTd DataLabel="VA Name">@context.VaName</MudTd>
            <MudTd DataLabel="Notes">@context.Description</MudTd>
            <MudTd DataLabel="D/C">@context.DebetCredit</MudTd>
            <MudTd DataLabel="Amount">@context.Amount.ToString("N0")</MudTd>
            <MudTd DataLabel="Requested By">@context.UsrName</MudTd>
            <MudTd DataLabel="Requested Date">@context.RequestDate</MudTd>
            <MudTd DataLabel="Status">@context.StatusName</MudTd>
            <MudTd DataLabel="Aksi">
                <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small"
                               OnClick="@(() => OpenDetailDialog(context))" title="Lihat" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Style="opacity:.65">Tidak ada adjustment ditemukan.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 25, 50 }" />
        </PagerContent>
    </MudTable>
}

@code {
    private List<VaTransRequestDto> _items = new();
    private List<VaAccountDto> _accounts = new();
    private string _filter = string.Empty;
    private bool _loading = true;
    private string? _error;
    private int _rowsPerPage = 10;
    private static readonly DialogOptions WideDialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true };

    protected override async Task OnInitializedAsync()
    {
        var accounts = await AccountManagement.GetAccountsAsync() ?? new();
        _accounts = accounts.Where(a => a.Active).ToList();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        var result = await RequestManagement.GetAdjustmentRecordsAsync(_filter);
        if (result == null)
        {
            _error = "Gagal memuat daftar adjustment.";
            _items = new();
        }
        else
        {
            _items = result;
        }

        _loading = false;
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadAsync();
    }

    private static Color StatusColor(string? status) => status switch
    {
        "1" => Color.Success,
        "2" => Color.Error,
        _ => Color.Warning
    };

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<VaAdjustmentCreateDialog> { { x => x.Accounts, _accounts } };
        var dialog = await DialogService.ShowAsync<VaAdjustmentCreateDialog>("Tambah Adjustment", parameters, WideDialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Snackbar.Add("Adjustment berhasil diajukan.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task OpenDetailDialog(VaTransRequestDto item)
    {
        var parameters = new DialogParameters<VaAdjustmentDetailDialog> { { x => x.Request, item } };
        await DialogService.ShowAsync<VaAdjustmentDetailDialog>("Detail Adjustment", parameters, WideDialogOptions);
    }
}
