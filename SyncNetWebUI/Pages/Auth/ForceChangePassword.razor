@page "/force-change-password"
@layout AuthLayout
@attribute [AllowAnonymous]
@inject AuthService AuthService
@inject PendingChallengeState PendingChallenge
@inject NavigationManager Navigation

<AuthShell>
    <MudText Typo="Typo.h5" Style="font-weight:600;">Buat Password Baru</MudText>
    <MudText Typo="Typo.body2" Style="opacity:.65" Class="mb-6">
        Password sementara Anda harus diganti sebelum melanjutkan.
    </MudText>

    <MudForm @ref="_form" Model="_model">
        <MudTextField T="string" Label="Password Baru" @bind-Value="_model.NewPassword"
                      InputType="InputType.Password"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Lock"
                      Required="true" RequiredError="Password baru wajib diisi"
                      Validation="@(new Func<string, string?>(ValidateNewPassword))"
                      Disabled="_busy" Class="mb-4" />

        <MudTextField T="string" Label="Ulangi Password Baru" @bind-Value="_model.ConfirmPassword"
                      InputType="InputType.Password"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Lock"
                      Required="true" RequiredError="Konfirmasi password wajib diisi"
                      Validation="@(new Func<string, string?>(ValidateConfirm))"
                      Disabled="_busy" Class="mb-4" />

        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4" Dense="true">@_error</MudAlert>
        }

        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large"
                   OnClick="SubmitAsync" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Simpan &amp; Masuk
        </MudButton>
    </MudForm>
</AuthShell>

@code {
    private MudForm _form = null!;
    private readonly Model _model = new();
    private bool _busy;
    private string? _error;

    protected override void OnInitialized()
    {
        // No pending challenge in memory (fresh page load / direct link) — the current
        // password proof was never persisted anywhere durable, so there's nothing to
        // complete here. Send them back to log in again.
        if (string.IsNullOrEmpty(PendingChallenge.UserName) || string.IsNullOrEmpty(PendingChallenge.CurrentPassword))
        {
            Navigation.NavigateTo("/login", forceLoad: false);
        }
    }

    private string? ValidateNewPassword(string value) =>
        value.Length < 8 ? "Minimal 8 karakter" : null;

    private string? ValidateConfirm(string value) =>
        value != _model.NewPassword ? "Tidak sama dengan password baru" : null;

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        _busy = true;
        _error = null;

        var result = await AuthService.CompleteNewPasswordAsync(
            PendingChallenge.UserName!, PendingChallenge.CurrentPassword!, _model.NewPassword);

        _busy = false;

        if (result.IsSuccess)
        {
            PendingChallenge.Clear();
            Navigation.NavigateTo("/", forceLoad: false);
            return;
        }

        _error = result.ErrorMessage ?? "Gagal menyimpan password baru.";
    }

    private class Model
    {
        public string NewPassword { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
