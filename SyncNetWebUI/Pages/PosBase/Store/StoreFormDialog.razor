@inject LookupService LookupManagement

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">
                <MudIcon Icon="@Icons.Material.Filled.Storefront" />
            </MudAvatar>
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6">@(IsEdit ? "Edit Store" : "Tambah Store")</MudText>
                @if (IsEdit)
                {
                    <MudText Typo="Typo.caption" Style="opacity:.65">@_model.StoreId</MudText>
                }
            </MudStack>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="_model" Class="px-2">
            <MudTabs Elevation="0" Rounded="false" SliderColor="Color.Primary" TabPanelsClass="pa-6" Class="mt-2">
                <MudTabPanel Text="General" ToolTip="General" Icon="@Icons.Material.Filled.Info">
                    <MudGrid Spacing="5">
                        <MudItem xs="12" sm="6">
                            <MudTextField T="string" Label="Store ID" @bind-Value="_model.StoreId"
                                          Disabled="@(IsEdit || _busy)" Required="true" RequiredError="Store ID wajib diisi" MaxLength="15" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudAutocomplete T="string" Label="Merchant" @bind-Value="_model.MerchantId"
                                             SearchFunc="SearchMerchants" ToStringFunc="@(id => MerchantLabel(id))"
                                             Required="true" RequiredError="Merchant wajib dipilih" Disabled="_busy"
                                             Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                             CoerceValue="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField T="string" Label="Store Name" @bind-Value="_model.Name" MaxLength="30" Disabled="_busy" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudDatePicker Label="Date Join" @bind-Date="_dateJoin" Disabled="_busy" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudSwitch T="bool" Value="_model.Active" ValueChanged="@(v => _model.Active = v)" Color="Color.Success" Disabled="_busy">
                                @(_model.Active ? "Active" : "Not Active")
                            </MudSwitch>
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>

                <MudTabPanel Text="Address" ToolTip="Address" Icon="@Icons.Material.Filled.Place">
                    <MudGrid Spacing="5">
                        <MudItem xs="12" sm="6">
                            <MudTextField T="string" Label="Alamat" @bind-Value="_model.Address" MaxLength="50" Disabled="_busy" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudAutocomplete T="string" Label="Kota" @bind-Value="_model.City" SearchFunc="SearchCities"
                                             Disabled="_busy" Clearable="true"
                                             Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                             CoerceValue="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField T="string" Label="Kode Pos" @bind-Value="_model.Zipcode" MaxLength="5" Disabled="_busy" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField T="string" Label="Telepon" @bind-Value="_model.Phone" MaxLength="30" Disabled="_busy" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField T="string" Label="Fax" @bind-Value="_model.Fax" MaxLength="30" Disabled="_busy" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField T="string" Label="Email" @bind-Value="_model.Email" InputType="InputType.Email" MaxLength="30" Disabled="_busy" />
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>
            </MudTabs>

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mt-2" Dense="true">@_error</MudAlert>
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_busy">Batal</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Simpan
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Inject] private StoreManagementService StoreManagement { get; set; } = null!;
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public List<MerchantDto> Merchants { get; set; } = new();
    [Parameter] public StoreDto? Store { get; set; }

    private MudForm _form = null!;
    private readonly FormModel _model = new();
    private DateTime? _dateJoin;
    private bool _busy;
    private string? _error;
    private List<LookupItemDto> _cities = new();

    protected override async Task OnInitializedAsync()
    {
        _cities = await LookupManagement.GetCitiesAsync() ?? new();

        if (IsEdit && Store != null)
        {
            _model.StoreId = Store.StoreId;
            _model.MerchantId = Store.MerchantId ?? string.Empty;
            _model.Name = Store.Name ?? string.Empty;
            if (DateTime.TryParseExact(Store.DateJoin, "yyyyMMdd", null, System.Globalization.DateTimeStyles.None, out var d))
                _dateJoin = d;
            _model.City = Store.City ?? string.Empty;
            _model.Address = Store.Address ?? string.Empty;
            _model.Zipcode = Store.Zipcode ?? string.Empty;
            _model.Phone = Store.Phone ?? string.Empty;
            _model.Fax = Store.Fax ?? string.Empty;
            _model.Email = Store.Email ?? string.Empty;
            _model.Active = Store.Active;
        }
    }

    private string MerchantLabel(string? id) => Merchants.FirstOrDefault(m => m.MerchantId == id) is { } m ? $"{m.MerchantId} - {m.Name}" : (id ?? string.Empty);

    private Task<IEnumerable<string>> SearchMerchants(string value, CancellationToken ct)
    {
        var results = string.IsNullOrWhiteSpace(value)
            ? Merchants.Select(m => m.MerchantId)
            : Merchants.Where(m => m.MerchantId.Contains(value, StringComparison.OrdinalIgnoreCase) || (m.Name ?? "").Contains(value, StringComparison.OrdinalIgnoreCase)).Select(m => m.MerchantId);
        return Task.FromResult(results.Take(20));
    }

    private Task<IEnumerable<string>> SearchCities(string value, CancellationToken ct)
    {
        var results = string.IsNullOrWhiteSpace(value)
            ? _cities.Select(c => c.Value)
            : _cities.Where(c => c.Value.Contains(value, StringComparison.OrdinalIgnoreCase)).Select(c => c.Value);
        return Task.FromResult(results.Take(20));
    }

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        _busy = true;
        _error = null;
        var dateJoinStr = _dateJoin?.ToString("yyyyMMdd");

        if (IsEdit)
        {
            var request = new UpdateStoreRequest
            {
                MerchantId = _model.MerchantId,
                Name = _model.Name,
                City = _model.City,
                Address = _model.Address,
                Zipcode = _model.Zipcode,
                Phone = _model.Phone,
                Fax = _model.Fax,
                Email = _model.Email,
                Active = _model.Active,
                DateJoin = dateJoinStr
            };
            var (success, error) = await StoreManagement.UpdateStoreAsync(_model.StoreId, request);
            _busy = false;

            if (success) { MudDialog.Close(DialogResult.Ok(true)); return; }
            _error = error ?? "Gagal menyimpan perubahan.";
        }
        else
        {
            var request = new CreateStoreRequest
            {
                StoreId = _model.StoreId,
                MerchantId = _model.MerchantId,
                Name = _model.Name,
                City = _model.City,
                Address = _model.Address,
                Zipcode = _model.Zipcode,
                Phone = _model.Phone,
                Fax = _model.Fax,
                Email = _model.Email,
                Active = _model.Active,
                DateJoin = dateJoinStr
            };
            var (success, _, error) = await StoreManagement.CreateStoreAsync(request);
            _busy = false;

            if (success) { MudDialog.Close(DialogResult.Ok(true)); return; }
            _error = error ?? "Gagal menambahkan store.";
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private class FormModel
    {
        public string StoreId { get; set; } = string.Empty;
        public string MerchantId { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string City { get; set; } = string.Empty;
        public string Address { get; set; } = string.Empty;
        public string Zipcode { get; set; } = string.Empty;
        public string Phone { get; set; } = string.Empty;
        public string Fax { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public bool Active { get; set; } = true;
    }
}
