@page "/tools-encrypt-creden"
@attribute [Authorize]
@inject ToolsService Tools

<PageTitle>Encrypt Credential</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">Encrypt Credential</MudText>
<MudText Typo="Typo.body1" Style="opacity:.65" Class="mb-6">Tools > Encrypt Credential.</MudText>

<MudPaper Class="pa-4" Elevation="1">
    <MudStack Spacing="4">
        <MudRadioGroup T="string" @bind-Value="_configType" Disabled="_busy">
            <MudStack Row="true" Spacing="4">
                <MudRadio T="string" Value="@("JSON")" Color="Color.Primary">JSON</MudRadio>
                <MudRadio T="string" Value="@("XML")" Color="Color.Secondary">XML</MudRadio>
            </MudStack>
        </MudRadioGroup>

        <MudTextField T="string" Label="Value" @bind-Value="_value" Variant="Variant.Outlined" Lines="2" Disabled="_busy" />
        <MudTextField T="string" Value="_result" Label="Encrypted" Variant="Variant.Outlined" Lines="3" ReadOnly="true" />

        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="EncryptAsync" Disabled="_busy" Style="width:fit-content">Encrypt</MudButton>

        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
        }
    </MudStack>
</MudPaper>

@code {
    private string _configType = "JSON";
    private string _value = string.Empty;
    private string _result = string.Empty;
    private string? _error;
    private bool _busy;

    private async Task EncryptAsync()
    {
        _error = null;

        if (string.IsNullOrEmpty(_value)) return;

        _busy = true;
        var (result, error) = await Tools.EncryptCredentialAsync(_value, _configType);
        _busy = false;

        if (result == null) { _error = error ?? "Gagal mengenkripsi value."; return; }
        _result = result;
    }
}
