<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">
                <MudIcon Icon="@Icons.Material.Filled.Person" />
            </MudAvatar>
            <MudText Typo="Typo.h6">@(IsEdit ? "Edit Member" : "Tambah Member")</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="_model" Class="px-2 pt-4">
            <MudGrid Spacing="5">
                <MudItem xs="12">
                    <MudTextField T="string" Label="Member Name" @bind-Value="_model.Name"
                                  Disabled="_busy" Required="true" RequiredError="Member name wajib diisi" MaxLength="50" />
                </MudItem>
                <MudItem xs="12">
                    <MudSelect T="int" Label="Team" @bind-Value="_model.TeamId" Required="true" RequiredError="Team wajib dipilih" Disabled="_busy">
                        @foreach (var t in Teams)
                        {
                            <MudSelectItem T="int" Value="@t.TeamId">@t.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField T="string" Label="Phone" @bind-Value="_model.Phone"
                                  Disabled="_busy" Required="true" RequiredError="Phone wajib diisi" MaxLength="30" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField T="string" Label="Email" @bind-Value="_model.Email" InputType="InputType.Email"
                                  Disabled="_busy" Required="true" RequiredError="Email wajib diisi" MaxLength="50" />
                </MudItem>
                @if (IsEdit)
                {
                    <MudItem xs="12">
                        <MudSwitch T="bool" Value="_model.Active" ValueChanged="@(v => _model.Active = v)" Color="Color.Primary" Disabled="_busy">Aktif</MudSwitch>
                    </MudItem>
                }
            </MudGrid>

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mt-4" Dense="true">@_error</MudAlert>
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_busy">Batal</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Simpan
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Inject] private SupportMemberManagementService MemberManagement { get; set; } = null!;
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public List<SupportTeamDto> Teams { get; set; } = new();
    [Parameter] public SupportMemberDto? Member { get; set; }

    private MudForm _form = null!;
    private readonly FormModel _model = new();
    private bool _busy;
    private string? _error;

    protected override void OnInitialized()
    {
        if (IsEdit && Member != null)
        {
            _model.MemberId = Member.MemberId;
            _model.TeamId = Member.TeamId;
            _model.Name = Member.Name ?? string.Empty;
            _model.Phone = Member.Phone ?? string.Empty;
            _model.Email = Member.Email ?? string.Empty;
            _model.Active = Member.Active;
        }
        else if (Teams.Count > 0)
        {
            _model.TeamId = Teams[0].TeamId;
        }
    }

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        _busy = true;
        _error = null;

        if (IsEdit)
        {
            var (success, error) = await MemberManagement.UpdateMemberAsync(_model.MemberId, new UpdateSupportMemberRequest
            {
                TeamId = _model.TeamId,
                Name = _model.Name,
                Email = _model.Email,
                Phone = _model.Phone,
                Active = _model.Active
            });
            _busy = false;

            if (success) { MudDialog.Close(DialogResult.Ok(true)); return; }
            _error = error ?? "Gagal menyimpan perubahan.";
        }
        else
        {
            var request = new CreateSupportMemberRequest
            {
                TeamId = _model.TeamId,
                Name = _model.Name,
                Email = _model.Email,
                Phone = _model.Phone
            };
            var (success, _, error) = await MemberManagement.CreateMemberAsync(request);
            _busy = false;

            if (success) { MudDialog.Close(DialogResult.Ok(true)); return; }
            _error = error ?? "Gagal menambahkan member.";
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private class FormModel
    {
        public int MemberId { get; set; }
        public int TeamId { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Phone { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public bool Active { get; set; } = true;
    }
}
