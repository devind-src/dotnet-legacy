@page "/profile/change-password"
@attribute [Authorize]
@inject AuthService AuthService
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<div style="position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:1401;display:flex;align-items:center;justify-content:center;overflow:auto;">
<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8 mb-8">
    <MudPaper Class="pa-8" Elevation="8">
        <MudText Typo="Typo.h5" Class="mb-4">Ganti Password</MudText>

        <MudForm @ref="_form" Model="_model">
            <MudGrid>
                <MudItem xs="12">
                    <MudTextField T="string" Label="Password Lama" @bind-Value="_model.OldPassword"
                                  Adornment="Adornment.End" AdornmentIcon="@_passwordAdornmentIcon"
                                  OnAdornmentClick="ToggleShowPassword" AdornmentAriaLabel="Tampilkan password"
                                  InputType="@_passwordInput"
                                  Required="true" RequiredError="Password lama wajib diisi"
                                  Disabled="_busy" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField T="string" Label="Password Baru" @bind-Value="_model.NewPassword"
                                  Adornment="Adornment.End" AdornmentIcon="@_passwordAdornmentIcon"
                                  OnAdornmentClick="ToggleShowPassword" AdornmentAriaLabel="Tampilkan password"
                                  InputType="@_passwordInput"
                                  Required="true" RequiredError="Password baru wajib diisi"
                                  Validation="@(new Func<string, string?>(v => v.Length < 8 ? "Minimal 8 karakter" : null))"
                                  Disabled="_busy" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField T="string" Label="Ulangi Password Baru" @bind-Value="_model.ConfirmPassword"
                                  Adornment="Adornment.End" AdornmentIcon="@_passwordAdornmentIcon"
                                  OnAdornmentClick="ToggleShowPassword" AdornmentAriaLabel="Tampilkan password"
                                  InputType="@_passwordInput"
                                  Required="true" RequiredError="Konfirmasi password wajib diisi"
                                  Validation="@(new Func<string, string?>(v => v != _model.NewPassword ? "Tidak sama dengan password baru" : null))"
                                  Disabled="_busy" />
                </MudItem>
            </MudGrid>

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mb-3 mt-3" Dense="true">@_error</MudAlert>
            }

            <MudStack Row="true" Spacing="2" Class="mt-4">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync" Disabled="_busy">
                    @if (_busy)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    Simpan
                </MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="CancelAsync" Disabled="_busy">Batal</MudButton>
            </MudStack>
        </MudForm>
    </MudPaper>
</MudContainer>
</div>

@code {
    private MudForm _form = null!;
    private readonly Model _model = new();
    private bool _busy;
    private string? _error;

    private bool _showPassword;
    private InputType _passwordInput = InputType.Password;
    private string _passwordAdornmentIcon = Icons.Material.Filled.VisibilityOff;

    private void ToggleShowPassword()
    {
        _showPassword = !_showPassword;
        _passwordInput = _showPassword ? InputType.Text : InputType.Password;
        _passwordAdornmentIcon = _showPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;
    }

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        _busy = true;
        _error = null;

        var result = await AuthService.ChangePasswordAsync(_model.OldPassword, _model.NewPassword);

        _busy = false;

        if (result.Success)
        {
            Snackbar.Add("Password berhasil diganti. Sesi lain sudah di-logout otomatis.", Severity.Success);
            _model.OldPassword = _model.NewPassword = _model.ConfirmPassword = string.Empty;
            return;
        }

        _error = result.Error ?? "Gagal mengganti password.";
    }

    /// <summary>Returns to whatever page the user came from (this page is always reached by
    /// navigating from elsewhere within the app, never a bookmark-able entry point).</summary>
    private async Task CancelAsync() => await JS.InvokeVoidAsync("history.back");

    private class Model
    {
        public string OldPassword { get; set; } = string.Empty;
        public string NewPassword { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
