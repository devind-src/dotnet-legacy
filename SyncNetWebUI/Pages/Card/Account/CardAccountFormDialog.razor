<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">
                <MudIcon Icon="@Icons.Material.Filled.CreditCard" />
            </MudAvatar>
            <MudText Typo="Typo.h6">@(IsEdit ? "Edit Account" : "Tambah Account")</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="_model" Class="px-2 pt-4">
            <MudGrid Spacing="5">
                <MudItem xs="12">
                    <MudSelect T="int" Label="Group" @bind-Value="_model.GroupId" Required="true" RequiredError="Group wajib dipilih" Disabled="_busy || IsEdit">
                        @foreach (var g in Groups)
                        {
                            <MudSelectItem T="int" Value="@g.GroupId">@g.GroupName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudSelect T="string" Label="Account Type" @bind-Value="_model.AccType" Required="true" RequiredError="Account type wajib dipilih" Disabled="_busy">
                        @foreach (var t in AccountTypes)
                        {
                            <MudSelectItem T="string" Value="@t.AcctType">@t.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudSelect T="bool" Label="PAN Verification" @bind-Value="_model.PanVerification" Disabled="_busy">
                        <MudSelectItem T="bool" Value="false">No</MudSelectItem>
                        <MudSelectItem T="bool" Value="true">Yes</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudSelect T="bool" Label="PIN Verification" @bind-Value="_model.PinVerification" Disabled="_busy">
                        <MudSelectItem T="bool" Value="false">No</MudSelectItem>
                        <MudSelectItem T="bool" Value="true">Yes</MudSelectItem>
                    </MudSelect>
                </MudItem>
            </MudGrid>

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mt-4" Dense="true">@_error</MudAlert>
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_busy">Batal</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Simpan
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Inject] private CardAccountManagementService AccountManagement { get; set; } = null!;
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public List<CardGroupDto> Groups { get; set; } = new();
    [Parameter] public List<AccountTypeDto> AccountTypes { get; set; } = new();
    [Parameter] public CardAccountDto? Account { get; set; }

    private MudForm _form = null!;
    private readonly FormModel _model = new();
    private bool _busy;
    private string? _error;

    protected override void OnInitialized()
    {
        if (IsEdit && Account != null)
        {
            _model.Id = Account.Id;
            _model.GroupId = Account.GroupId ?? 0;
            _model.AccType = Account.AccType ?? string.Empty;
            _model.PanVerification = Account.PanVerification;
            _model.PinVerification = Account.PinVerification;
        }
        else
        {
            if (Groups.Count > 0) _model.GroupId = Groups[0].GroupId;
            if (AccountTypes.Count > 0) _model.AccType = AccountTypes[0].AcctType;
        }
    }

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        _busy = true;
        _error = null;

        if (IsEdit)
        {
            var (success, error) = await AccountManagement.UpdateAccountAsync(_model.Id, new UpdateCardAccountRequest
            {
                AccType = _model.AccType,
                PanVerification = _model.PanVerification,
                PinVerification = _model.PinVerification
            });
            _busy = false;

            if (success) { MudDialog.Close(DialogResult.Ok(true)); return; }
            _error = error ?? "Gagal menyimpan perubahan.";
        }
        else
        {
            var request = new CreateCardAccountRequest
            {
                GroupId = _model.GroupId,
                AccType = _model.AccType,
                PanVerification = _model.PanVerification,
                PinVerification = _model.PinVerification
            };
            var (success, _, error) = await AccountManagement.CreateAccountAsync(request);
            _busy = false;

            if (success) { MudDialog.Close(DialogResult.Ok(true)); return; }
            _error = error ?? "Gagal menambahkan account.";
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private class FormModel
    {
        public int Id { get; set; }
        public int GroupId { get; set; }
        public string AccType { get; set; } = string.Empty;
        public bool PanVerification { get; set; }
        public bool PinVerification { get; set; }
    }
}
