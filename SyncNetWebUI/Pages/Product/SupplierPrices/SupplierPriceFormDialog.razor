<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">
                <MudIcon Icon="@Icons.Material.Filled.Sell" />
            </MudAvatar>
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6">@(IsEdit ? "Edit Supplier Price" : "Tambah Supplier Price")</MudText>
                @if (IsEdit)
                {
                    <MudText Typo="Typo.caption" Style="opacity:.65">ID @Item?.Id</MudText>
                }
            </MudStack>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="_model" Class="px-2 pt-4">
            <MudGrid Spacing="5">
                <MudItem xs="12" sm="6">
                    <MudSelect T="string" Label="Supplier" @bind-Value="_model.SupplierId"
                               Disabled="@(IsEdit || _busy)" Required="true" RequiredError="Supplier wajib dipilih">
                        @foreach (var n in BillerNodes)
                        {
                            <MudSelectItem T="string" Value="@n.NodeName">@n.NodeName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    @if (IsEdit)
                    {
                        <MudTextField T="string" Label="Product ID" Value="@FormatProduct(_model.BillerCode)" Disabled="true" />
                    }
                    else
                    {
                        <MudAutocomplete T="string" Label="Product ID" @bind-Value="_model.BillerCode"
                                         SearchFunc="SearchProducts" ToStringFunc="FormatProduct" Required="true" RequiredError="Product ID wajib diisi"
                                         CoerceValue="true" Disabled="_busy" MaxLength="15" />
                    }
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="int?" Label="Denom" @bind-Value="_model.Denom" Disabled="_busy" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="int" Label="Harga Beli" @bind-Value="_model.HargaBeli" Disabled="_busy"
                                      Required="true" RequiredError="Harga Beli wajib diisi" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="int?" Label="Harga Jual" @bind-Value="_model.HargaJual" Disabled="_busy" />
                </MudItem>
                <MudItem xs="12">
                    <MudSwitch T="bool" Value="_model.Active" ValueChanged="@(v => _model.Active = v)" Color="Color.Primary" Disabled="_busy">
                        @(_model.Active ? "Aktif" : "Nonaktif")
                    </MudSwitch>
                </MudItem>
            </MudGrid>

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mt-4" Dense="true">@_error</MudAlert>
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_busy">Batal</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Simpan
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Inject] private ProductSupplierPriceManagementService PriceManagement { get; set; } = null!;
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public ProductSupplierPriceDto? Item { get; set; }
    [Parameter] public List<NodeDto> Nodes { get; set; } = new();
    [Parameter] public List<LookupItemDto> TopupProducts { get; set; } = new();

    private MudForm _form = null!;
    private readonly FormModel _model = new();
    private bool _busy;
    private string? _error;

    // Mirrors legacy NodeGetNodeBiller filter (category "0"/"2" = Both/Biller-Issuer).
    private IEnumerable<NodeDto> BillerNodes => Nodes.Where(n => n.Category is "0" or "2");

    protected override void OnInitialized()
    {
        if (IsEdit && Item != null)
        {
            _model.SupplierId = Item.SupplierId ?? string.Empty;
            _model.BillerCode = Item.BillerCode;
            _model.Denom = Item.Denom;
            _model.HargaBeli = Item.HargaBeli ?? 0;
            _model.HargaJual = Item.HargaJual;
            _model.Active = Item.Active;
        }
        else
        {
            _model.SupplierId = BillerNodes.FirstOrDefault()?.NodeName ?? string.Empty;
        }
    }

    private Task<IEnumerable<string>> SearchProducts(string? value, CancellationToken ct)
    {
        var matches = string.IsNullOrWhiteSpace(value)
            ? TopupProducts.Select(p => p.Key)
            : TopupProducts.Where(p => p.Key.Contains(value, StringComparison.OrdinalIgnoreCase)
                                        || p.Value.Contains(value, StringComparison.OrdinalIgnoreCase))
                            .Select(p => p.Key);
        return Task.FromResult(matches);
    }

    private string? FormatProduct(string? code)
    {
        if (string.IsNullOrEmpty(code)) return code;
        var match = TopupProducts.FirstOrDefault(p => p.Key == code);
        return match == null ? code : $"{match.Key} — {match.Value}";
    }

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        _busy = true;
        _error = null;

        if (IsEdit && Item != null)
        {
            var request = new UpdateProductSupplierPriceRequest { Denom = _model.Denom, HargaBeli = _model.HargaBeli, HargaJual = _model.HargaJual, Active = _model.Active };
            var (success, error) = await PriceManagement.UpdatePriceAsync(Item.Id, request);
            _busy = false;

            if (success) { MudDialog.Close(DialogResult.Ok(true)); return; }
            _error = error ?? "Gagal menyimpan perubahan.";
        }
        else
        {
            var request = new CreateProductSupplierPriceRequest { SupplierId = _model.SupplierId, BillerCode = _model.BillerCode ?? string.Empty, Denom = _model.Denom, HargaBeli = _model.HargaBeli, HargaJual = _model.HargaJual, Active = _model.Active };
            var (success, _, error) = await PriceManagement.CreatePriceAsync(request);
            _busy = false;

            if (success) { MudDialog.Close(DialogResult.Ok(true)); return; }
            _error = error ?? "Gagal menambahkan supplier price.";
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private class FormModel
    {
        public string SupplierId { get; set; } = string.Empty;
        public string? BillerCode { get; set; }
        public int? Denom { get; set; }
        public int HargaBeli { get; set; }
        public int? HargaJual { get; set; }
        public bool Active { get; set; } = true;
    }
}
