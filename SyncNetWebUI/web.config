<?xml version="1.0" encoding="utf-8"?>
<!--
  Customizes the web.config that the Blazor WebAssembly SDK generates on publish (the required
  mimeMap/httpCompression/rewrite entries for IIS are merged into this file automatically —
  see https://learn.microsoft.com/aspnet/core/blazor/host-and-deploy/webassembly#iis).

  Why this file exists: index.html, css/app.css, appsettings.json etc. keep the same filename
  across builds, so without explicit headers a browser/proxy can keep serving a stale copy after
  a deploy. _framework/*.dll/.wasm files are fingerprinted (hash in the filename), so they are
  safe to cache forever — everything else defaults to no-cache so a plain page refresh always
  picks up the new build.
-->
<configuration>
  <location path="_framework">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" cacheControlCustom="public, immutable" />
      </staticContent>
    </system.webServer>
  </location>

  <system.webServer>
    <staticContent>
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
  </system.webServer>
</configuration>
