@page "/reset-password"
@layout AuthLayout
@attribute [AllowAnonymous]
@inject AuthService AuthService
@inject NavigationManager Navigation

<AuthShell>
    <MudText Typo="Typo.h5" Style="font-weight:600;" Class="mb-6">Reset Password</MudText>

    @if (string.IsNullOrEmpty(Token))
    {
        <MudAlert Severity="Severity.Error">Link reset tidak valid — token tidak ditemukan.</MudAlert>
    }
    else if (_done)
    {
        <MudAlert Severity="Severity.Success" Class="mb-4">Password berhasil diganti.</MudAlert>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large" Href="/login">
            Ke halaman Login
        </MudButton>
    }
    else
    {
        <MudForm @ref="_form" Model="_model">
            <MudTextField T="string" Label="Password Baru" @bind-Value="_model.NewPassword"
                          InputType="InputType.Password"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Lock"
                          Required="true" RequiredError="Password baru wajib diisi"
                          Validation="@(new Func<string, string?>(v => v.Length < 8 ? "Minimal 8 karakter" : null))"
                          Disabled="_busy" Class="mb-4" />

            <MudTextField T="string" Label="Ulangi Password Baru" @bind-Value="_model.ConfirmPassword"
                          InputType="InputType.Password"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Lock"
                          Required="true" RequiredError="Konfirmasi password wajib diisi"
                          Validation="@(new Func<string, string?>(v => v != _model.NewPassword ? "Tidak sama dengan password baru" : null))"
                          Disabled="_busy" Class="mb-4" />

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4" Dense="true">@_error</MudAlert>
            }

            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large"
                       OnClick="SubmitAsync" Disabled="_busy">
                @if (_busy)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Simpan Password Baru
            </MudButton>
        </MudForm>
    }
</AuthShell>

@code {
    private MudForm _form = null!;
    private readonly Model _model = new();
    private bool _busy;
    private bool _done;
    private string? _error;

    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        _busy = true;
        _error = null;

        var result = await AuthService.ResetPasswordAsync(Token!, _model.NewPassword);

        _busy = false;

        if (result.Success)
        {
            _done = true;
            return;
        }

        _error = result.Error ?? "Token tidak valid atau sudah kedaluwarsa.";
    }

    private class Model
    {
        public string NewPassword { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
