<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">
                <MudIcon Icon="@Icons.Material.Filled.CreditCard" />
            </MudAvatar>
            <MudText Typo="Typo.h6">@(IsEdit ? "Edit BIN" : "Tambah BIN")</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="_model" Class="px-2 pt-4">
            <MudGrid Spacing="5">
                <MudItem xs="12">
                    <MudSelect T="int" Label="Group" @bind-Value="_model.GroupId" Required="true" RequiredError="Group wajib dipilih" Disabled="_busy || IsEdit">
                        @foreach (var g in Groups)
                        {
                            <MudSelectItem T="int" Value="@g.GroupId">@g.GroupName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField T="string" Label="BIN" @bind-Value="_model.BinNr"
                                  Disabled="_busy || IsEdit" Required="true" RequiredError="BIN wajib diisi" MaxLength="16" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField T="string" Label="Description" @bind-Value="_model.BinDesc"
                                  Disabled="_busy" Required="true" RequiredError="Description wajib diisi" MaxLength="20" />
                </MudItem>
            </MudGrid>

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mt-4" Dense="true">@_error</MudAlert>
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_busy">Batal</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Simpan
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Inject] private CardBinManagementService BinManagement { get; set; } = null!;
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public List<CardGroupDto> Groups { get; set; } = new();
    [Parameter] public CardBinDto? Bin { get; set; }

    private MudForm _form = null!;
    private readonly FormModel _model = new();
    private bool _busy;
    private string? _error;

    protected override void OnInitialized()
    {
        if (IsEdit && Bin != null)
        {
            _model.BinNr = Bin.BinNr;
            _model.GroupId = Bin.GroupId;
            _model.BinDesc = Bin.BinDesc ?? string.Empty;
        }
        else if (Groups.Count > 0)
        {
            _model.GroupId = Groups[0].GroupId;
        }
    }

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        _busy = true;
        _error = null;

        if (IsEdit)
        {
            var (success, error) = await BinManagement.UpdateBinAsync(_model.BinNr, new UpdateCardBinRequest
            {
                BinDesc = _model.BinDesc
            });
            _busy = false;

            if (success) { MudDialog.Close(DialogResult.Ok(true)); return; }
            _error = error ?? "Gagal menyimpan perubahan.";
        }
        else
        {
            var request = new CreateCardBinRequest { BinNr = _model.BinNr, GroupId = _model.GroupId, BinDesc = _model.BinDesc };
            var (success, _, error) = await BinManagement.CreateBinAsync(request);
            _busy = false;

            if (success) { MudDialog.Close(DialogResult.Ok(true)); return; }
            _error = error ?? "Gagal menambahkan BIN.";
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private class FormModel
    {
        public string BinNr { get; set; } = string.Empty;
        public int GroupId { get; set; }
        public string BinDesc { get; set; } = string.Empty;
    }
}
