<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">
                <MudIcon Icon="@Icons.Material.Filled.Receipt" />
            </MudAvatar>
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6">@(IsEdit ? "Edit Tran Name" : "Tambah Tran Name")</MudText>
                @if (IsEdit)
                {
                    <MudText Typo="Typo.caption" Style="opacity:.65">@_model.TransCode</MudText>
                }
            </MudStack>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="_model" Class="px-2 pt-4">
            <MudGrid Spacing="5">
                <MudItem xs="12">
                    <MudTextField T="string" Label="Trans Code" @bind-Value="_model.TransCode"
                                  Disabled="@(IsEdit || _busy)" Required="true" RequiredError="Trans code wajib diisi" MaxLength="2" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField T="string" Label="Trans Name" @bind-Value="_model.TransName"
                                  Disabled="_busy" Required="true" RequiredError="Trans name wajib diisi" MaxLength="50" />
                </MudItem>
                @if (IsEdit)
                {
                    <MudItem xs="12">
                        <MudSwitch T="bool" Value="_model.Active" ValueChanged="@(v => _model.Active = v)" Color="Color.Primary" Disabled="_busy">Aktif</MudSwitch>
                    </MudItem>
                }
            </MudGrid>

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mt-4" Dense="true">@_error</MudAlert>
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_busy">Batal</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Simpan
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Inject] private TranNameManagementService TranNameManagement { get; set; } = null!;
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public TranNameDto? TranName { get; set; }

    private MudForm _form = null!;
    private readonly FormModel _model = new();
    private bool _busy;
    private string? _error;

    protected override void OnInitialized()
    {
        if (IsEdit && TranName != null)
        {
            _model.TransCode = TranName.TransCode;
            _model.TransName = TranName.TransNameValue ?? string.Empty;
            _model.Active = TranName.Active;
        }
    }

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        _busy = true;
        _error = null;

        if (IsEdit)
        {
            var (success, error) = await TranNameManagement.UpdateTranNameAsync(_model.TransCode,
                new UpdateTranNameRequest { TransName = _model.TransName, Active = _model.Active });
            _busy = false;

            if (success) { MudDialog.Close(DialogResult.Ok(true)); return; }
            _error = error ?? "Gagal menyimpan perubahan.";
        }
        else
        {
            var request = new CreateTranNameRequest { TransCode = _model.TransCode, TransName = _model.TransName };
            var (success, _, error) = await TranNameManagement.CreateTranNameAsync(request);
            _busy = false;

            if (success) { MudDialog.Close(DialogResult.Ok(true)); return; }
            _error = error ?? "Gagal menambahkan tran name.";
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private class FormModel
    {
        public string TransCode { get; set; } = string.Empty;
        public string TransName { get; set; } = string.Empty;
        public bool Active { get; set; } = true;
    }
}
