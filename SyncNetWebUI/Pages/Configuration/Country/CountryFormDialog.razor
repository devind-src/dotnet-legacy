<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">
                <MudIcon Icon="@Icons.Material.Filled.Public" />
            </MudAvatar>
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6">@(IsEdit ? "Edit Country" : "Tambah Country")</MudText>
                @if (IsEdit)
                {
                    <MudText Typo="Typo.caption" Style="opacity:.65">@_model.Name</MudText>
                }
            </MudStack>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="_model" Class="px-2 pt-4">
            <MudGrid Spacing="5">
                <MudItem xs="12">
                    <MudTextField T="string" Label="Name" @bind-Value="_model.Name"
                                  Disabled="@(IsEdit || _busy)" Required="true" RequiredError="Name wajib diisi" MaxLength="50" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField T="string" Label="Alpha-2" @bind-Value="_model.CodeAlpha2" Disabled="_busy" Required="true" RequiredError="Alpha-2 wajib diisi" MaxLength="2" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField T="string" Label="Alpha-3" @bind-Value="_model.CodeAlpha3" Disabled="_busy" Required="true" RequiredError="Alpha-3 wajib diisi" MaxLength="3" />
                </MudItem>
                <MudItem xs="12">
                    <MudNumericField T="int?" Label="Numeric" @bind-Value="_model.CodeNumeric" Disabled="_busy" Required="true" RequiredError="Numeric wajib diisi" />
                </MudItem>
                @if (IsEdit)
                {
                    <MudItem xs="12">
                        <MudSwitch T="bool" Value="_model.Active" ValueChanged="@(v => _model.Active = v)" Color="Color.Primary" Disabled="_busy">Aktif</MudSwitch>
                    </MudItem>
                }
            </MudGrid>

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mt-4" Dense="true">@_error</MudAlert>
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_busy">Batal</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Simpan
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Inject] private CountryManagementService CountryManagement { get; set; } = null!;
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public CountryDto? Country { get; set; }

    private MudForm _form = null!;
    private readonly FormModel _model = new();
    private bool _busy;
    private string? _error;

    protected override void OnInitialized()
    {
        if (IsEdit && Country != null)
        {
            _model.Name = Country.Name;
            _model.CodeAlpha2 = Country.CodeAlpha2;
            _model.CodeAlpha3 = Country.CodeAlpha3;
            _model.CodeNumeric = Country.CodeNumeric;
            _model.Active = Country.Active;
        }
    }

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        _busy = true;
        _error = null;

        if (IsEdit)
        {
            var (success, error) = await CountryManagement.UpdateCountryAsync(_model.Name, new UpdateCountryRequest
            {
                CodeAlpha2 = _model.CodeAlpha2,
                CodeAlpha3 = _model.CodeAlpha3,
                CodeNumeric = _model.CodeNumeric ?? 0,
                Active = _model.Active
            });
            _busy = false;

            if (success) { MudDialog.Close(DialogResult.Ok(true)); return; }
            _error = error ?? "Gagal menyimpan perubahan.";
        }
        else
        {
            var request = new CreateCountryRequest
            {
                Name = _model.Name,
                CodeAlpha2 = _model.CodeAlpha2,
                CodeAlpha3 = _model.CodeAlpha3,
                CodeNumeric = _model.CodeNumeric ?? 0
            };
            var (success, _, error) = await CountryManagement.CreateCountryAsync(request);
            _busy = false;

            if (success) { MudDialog.Close(DialogResult.Ok(true)); return; }
            _error = error ?? "Gagal menambahkan country.";
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private class FormModel
    {
        public string Name { get; set; } = string.Empty;
        public string? CodeAlpha2 { get; set; }
        public string? CodeAlpha3 { get; set; }
        public int? CodeNumeric { get; set; }
        public bool Active { get; set; } = true;
    }
}
