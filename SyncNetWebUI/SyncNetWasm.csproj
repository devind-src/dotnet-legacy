<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <RootNamespace>SyncNetWasm</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.11" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />

    <!-- UI component library (admin dashboard: data grid, forms, dialogs, snackbar) -->
    <PackageReference Include="MudBlazor" Version="9.8.0" />

    <!-- Refresh-token persistence across page reloads (see Services/TokenStorageService) -->
    <PackageReference Include="Blazored.LocalStorage" Version="4.5.0" />

    <!-- Home dashboard charts (Dashboard 2 tab) — same package/version as SyncNetBlazorServer's
         Index.razor, which this page was ported from. -->
    <PackageReference Include="Blazor-ApexCharts" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Request/response DTOs shared with the API — never hand-write a duplicate shape
         that can drift from what SyncNetApi actually accepts/returns. -->
    <ProjectReference Include="..\SyncNetApi.Contracts\SyncNetApi.Contracts.csproj" />
  </ItemGroup>

  <!-- Stamps wwwroot/version.json with a fresh value on every build so a running tab can detect
       a new deploy (see Services/AppVersionCheckService) — unlike blazor.boot.json's dll hashes,
       this changes even on a content-only change with no assembly diff. Runs before BeforeBuild
       so the new bytes are already on disk when the wwwroot content items are copied/published;
       this is not a Content item add (which would need to happen at evaluation time), just an
       in-place rewrite of a file the SDK already tracks. -->
  <Target Name="WriteAppVersionFile" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <AppVersionStamp>$([System.DateTime]::UtcNow.ToString(`yyyyMMddHHmmss`))</AppVersionStamp>
    </PropertyGroup>
    <WriteLinesToFile File="wwwroot/version.json" Lines="{&quot;version&quot;:&quot;$(AppVersionStamp)&quot;}" Overwrite="true" />
  </Target>

</Project>
