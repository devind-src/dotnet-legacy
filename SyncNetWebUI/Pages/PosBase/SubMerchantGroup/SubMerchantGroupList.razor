@page "/posbase-subgroup"
@attribute [Authorize]
@inject SubMerchantGroupManagementService GroupManagement
@inject ParticipantManagementService ParticipantManagement
@inject MerchantGroupManagementService MerchantGroupManagement
@inject SessionState Session
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Sub Merchant Group</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">Sub Merchant Group</MudText>
<MudText Typo="Typo.body1" Style="opacity:.65" Class="mb-6">Kelola pengelompokan sub merchant di bawah merchant group.</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
        <MudTextField T="string" @bind-Value="_filter" Label="Cari sub group" Immediate="true"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      OnKeyDown="OnSearchKeyDown" Class="flex-grow-1" Style="max-width:320px;" />
        <MudStack Row="true" Spacing="2">
            <MudIconButton Icon="@Icons.Material.Filled.Search" OnClick="LoadAsync" title="Cari" />
            @if (Session.UserManagementPermissions.CanAdd)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenCreateDialog">Tambah Sub Group</MudButton>
            }
        </MudStack>
    </MudStack>
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Class="mb-4" />
}
else if (_error != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}
else
{
    <MudTable Items="_items" Hover="true" Dense="true" Elevation="1" @bind-RowsPerPage="_rowsPerPage">
        <HeaderContent>
            <MudTh>Sub Group Name</MudTh>
            <MudTh>Participant</MudTh>
            <MudTh>Merchant Group</MudTh>
            <MudTh>Catatan</MudTh>
            <MudTh>Aksi</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Sub Group Name">@context.GroupName</MudTd>
            <MudTd DataLabel="Participant">@context.ParticipantId</MudTd>
            <MudTd DataLabel="Merchant Group">@context.ParentGroupName</MudTd>
            <MudTd DataLabel="Catatan">@context.Notes</MudTd>
            <MudTd DataLabel="Aksi">
                @if (Session.UserManagementPermissions.CanEdit)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                   OnClick="@(() => OpenEditDialog(context))" title="Edit" />
                }
                @if (Session.UserManagementPermissions.CanDelete)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                   OnClick="@(() => ConfirmDeleteAsync(context))" title="Hapus" />
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Style="opacity:.65">Tidak ada sub group ditemukan.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 25, 50 }" />
        </PagerContent>
    </MudTable>
}

@code {
    private List<SubMerchantGroupDto> _items = new();
    private List<ParticipantDto> _participants = new();
    private List<MerchantGroupDto> _merchantGroups = new();
    private string _filter = string.Empty;
    private bool _loading = true;
    private string? _error;
    private int _rowsPerPage = 10;
    private static readonly DialogOptions WideDialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true };

    protected override async Task OnInitializedAsync()
    {
        _participants = await ParticipantManagement.GetParticipantsAsync() ?? new();
        _merchantGroups = await MerchantGroupManagement.GetGroupsAsync() ?? new();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        var result = await GroupManagement.GetGroupsAsync(_filter);
        if (result == null)
        {
            _error = "Gagal memuat daftar sub group.";
            _items = new();
        }
        else
        {
            _items = result;
        }

        _loading = false;
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadAsync();
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<SubMerchantGroupFormDialog>
        {
            { x => x.IsEdit, false },
            { x => x.Participants, _participants },
            { x => x.MerchantGroups, _merchantGroups }
        };
        var dialog = await DialogService.ShowAsync<SubMerchantGroupFormDialog>("Tambah Sub Merchant Group", parameters, WideDialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Snackbar.Add("Sub group berhasil ditambahkan.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task OpenEditDialog(SubMerchantGroupDto group)
    {
        var parameters = new DialogParameters<SubMerchantGroupFormDialog>
        {
            { x => x.IsEdit, true },
            { x => x.Participants, _participants },
            { x => x.MerchantGroups, _merchantGroups },
            { x => x.Group, group }
        };
        var dialog = await DialogService.ShowAsync<SubMerchantGroupFormDialog>("Edit Sub Merchant Group", parameters, WideDialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Snackbar.Add("Perubahan sub group berhasil disimpan.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task ConfirmDeleteAsync(SubMerchantGroupDto group)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Hapus Sub Merchant Group",
            $"Yakin ingin menghapus sub group '{group.GroupName}'? Tindakan ini tidak bisa dibatalkan.",
            yesText: "Hapus", cancelText: "Batal");

        if (confirmed != true) return;

        var (success, error) = await GroupManagement.DeleteGroupAsync(group.GroupName);
        if (success)
        {
            Snackbar.Add("Sub group berhasil dihapus.", Severity.Success);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(error ?? "Gagal menghapus sub group.", Severity.Error);
        }
    }
}
