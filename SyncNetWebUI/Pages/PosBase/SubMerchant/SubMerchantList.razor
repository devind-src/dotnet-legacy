@page "/posbase-submerchant"
@attribute [Authorize]
@inject SubMerchantManagementService SubMerchantManagement
@inject MerchantManagementService MerchantManagement
@inject SessionState Session
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Sub Merchant</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">Sub Merchant</MudText>
<MudText Typo="Typo.body1" Style="opacity:.65" Class="mb-6">Kelola data sub merchant di bawah merchant.</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
        <MudTextField T="string" @bind-Value="_filter" Label="Cari sub merchant" Immediate="true"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      OnKeyDown="OnSearchKeyDown" Class="flex-grow-1" Style="max-width:320px;" />
        <MudStack Row="true" Spacing="2">
            <MudIconButton Icon="@Icons.Material.Filled.Search" OnClick="LoadAsync" title="Cari" />
            @if (Session.UserManagementPermissions.CanAdd)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenCreateDialog">Tambah Sub Merchant</MudButton>
            }
        </MudStack>
    </MudStack>
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Class="mb-4" />
}
else if (_error != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}
else
{
    <MudTable Items="_items" Hover="true" Dense="true" Elevation="1" @bind-RowsPerPage="_rowsPerPage">
        <HeaderContent>
            <MudTh>Sub Merchant ID</MudTh>
            <MudTh>Nama</MudTh>
            <MudTh>Merchant</MudTh>
            <MudTh>Kota</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Aksi</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Sub Merchant ID">@context.SubMerchantId</MudTd>
            <MudTd DataLabel="Nama">@context.Name</MudTd>
            <MudTd DataLabel="Merchant">@context.MerchantId</MudTd>
            <MudTd DataLabel="Kota">@context.City</MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Size="Size.Small" Color="@(context.Active ? Color.Success : Color.Default)">
                    @(context.Active ? "Aktif" : "Nonaktif")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Aksi">
                @if (Session.UserManagementPermissions.CanEdit)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                   OnClick="@(() => OpenEditDialog(context))" title="Edit" />
                }
                @if (Session.UserManagementPermissions.CanDelete)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                   OnClick="@(() => ConfirmDeleteAsync(context))" title="Hapus" />
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Style="opacity:.65">Tidak ada sub merchant ditemukan.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 25, 50 }" />
        </PagerContent>
    </MudTable>
}

@code {
    private List<SubMerchantDto> _items = new();
    private List<MerchantDto> _merchants = new();
    private string _filter = string.Empty;
    private bool _loading = true;
    private string? _error;
    private int _rowsPerPage = 10;
    private static readonly DialogOptions WideDialogOptions = new() { MaxWidth = MaxWidth.Large, FullWidth = true };

    protected override async Task OnInitializedAsync()
    {
        _merchants = await MerchantManagement.GetMerchantsAsync() ?? new();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        var result = await SubMerchantManagement.GetSubMerchantsAsync(_filter);
        if (result == null)
        {
            _error = "Gagal memuat daftar sub merchant.";
            _items = new();
        }
        else
        {
            _items = result;
        }

        _loading = false;
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadAsync();
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<SubMerchantFormDialog>
        {
            { x => x.IsEdit, false },
            { x => x.Merchants, _merchants }
        };
        var dialog = await DialogService.ShowAsync<SubMerchantFormDialog>("Tambah Sub Merchant", parameters, WideDialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Snackbar.Add("Sub merchant berhasil ditambahkan.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task OpenEditDialog(SubMerchantDto subMerchant)
    {
        var parameters = new DialogParameters<SubMerchantFormDialog>
        {
            { x => x.IsEdit, true },
            { x => x.Merchants, _merchants },
            { x => x.SubMerchant, subMerchant }
        };
        var dialog = await DialogService.ShowAsync<SubMerchantFormDialog>("Edit Sub Merchant", parameters, WideDialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Snackbar.Add("Perubahan sub merchant berhasil disimpan.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task ConfirmDeleteAsync(SubMerchantDto subMerchant)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Hapus Sub Merchant",
            $"Yakin ingin menghapus sub merchant '{subMerchant.SubMerchantId}'? Tindakan ini tidak bisa dibatalkan.",
            yesText: "Hapus", cancelText: "Batal");

        if (confirmed != true) return;

        var (success, error) = await SubMerchantManagement.DeleteSubMerchantAsync(subMerchant.SubMerchantId);
        if (success)
        {
            Snackbar.Add("Sub merchant berhasil dihapus.", Severity.Success);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(error ?? "Gagal menghapus sub merchant.", Severity.Error);
        }
    }
}
