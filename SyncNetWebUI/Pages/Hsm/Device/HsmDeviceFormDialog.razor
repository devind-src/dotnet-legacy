<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">
                <MudIcon Icon="@Icons.Material.Filled.VpnKey" />
            </MudAvatar>
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6">@(IsEdit ? "Edit HSM Device" : "Tambah HSM Device")</MudText>
                @if (IsEdit)
                {
                    <MudText Typo="Typo.caption" Style="opacity:.65">@_model.HsmName</MudText>
                }
            </MudStack>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="_model" Class="px-2 pt-4">
            <MudGrid Spacing="5">
                <MudItem xs="12" sm="6">
                    <MudTextField T="string" Label="HSM Name" @bind-Value="_model.HsmName"
                                  Disabled="@(IsEdit || _busy)" Required="true" RequiredError="HSM name wajib diisi" MaxLength="25" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField T="short?" Label="Priority" @bind-Value="_model.Priority" Min="0" Max="10" Disabled="_busy" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string" Label="Protocol" @bind-Value="_model.Protocol" Disabled="_busy">
                        <MudSelectItem Value="@("2")">Emulator</MudSelectItem>
                        <MudSelectItem Value="@("1")">TCP/IP</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSwitch T="bool" Value="_model.UseScheme" ValueChanged="@(v => _model.UseScheme = v)" Color="Color.Primary" Disabled="_busy">Use Key Scheme</MudSwitch>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField T="short?" Label="Message Header" @bind-Value="_model.MessageHeader" Min="0" Max="16" Disabled="_busy" />
                </MudItem>
                @if (_model.Protocol == "1")
                {
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Remote IP" @bind-Value="_model.RemoteIp" Disabled="_busy" MaxLength="15" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Remote Port" @bind-Value="_model.RemotePort" Disabled="_busy" MaxLength="5" />
                    </MudItem>
                }
                else
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Info" Dense="true">
                            Protocol Emulator — kalkulasi HSM (HSM &gt; Console, Key Management di Merchant/Terminal/Nodes) berjalan lokal, tidak butuh koneksi jaringan.
                        </MudAlert>
                    </MudItem>
                }
            </MudGrid>

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mt-4" Dense="true">@_error</MudAlert>
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_busy">Batal</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Simpan
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Inject] private HsmDeviceManagementService HsmDeviceManagement { get; set; } = null!;
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public HsmDeviceDto? Device { get; set; }

    private MudForm _form = null!;
    private readonly FormModel _model = new();
    private bool _busy;
    private string? _error;

    protected override void OnInitialized()
    {
        if (IsEdit && Device != null)
        {
            _model.HsmName = Device.HsmName;
            _model.Priority = Device.Priority;
            _model.Protocol = Device.Protocol ?? "2";
            _model.UseScheme = Device.UseScheme;
            _model.MessageHeader = Device.MessageHeader;
            _model.RemoteIp = Device.RemoteIp ?? string.Empty;
            _model.RemotePort = Device.RemotePort ?? string.Empty;
        }
    }

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        _busy = true;
        _error = null;

        if (IsEdit)
        {
            var (success, error) = await HsmDeviceManagement.UpdateHsmDeviceAsync(_model.HsmName, new UpdateHsmDeviceRequest
            {
                Priority = _model.Priority, Protocol = _model.Protocol, UseScheme = _model.UseScheme,
                MessageHeader = _model.MessageHeader, RemoteIp = _model.RemoteIp, RemotePort = _model.RemotePort
            });
            _busy = false;

            if (success) { MudDialog.Close(DialogResult.Ok(true)); return; }
            _error = error ?? "Gagal menyimpan perubahan.";
        }
        else
        {
            var request = new CreateHsmDeviceRequest
            {
                HsmName = _model.HsmName, Priority = _model.Priority, Protocol = _model.Protocol, UseScheme = _model.UseScheme,
                MessageHeader = _model.MessageHeader, RemoteIp = _model.RemoteIp, RemotePort = _model.RemotePort
            };
            var (success, _, error) = await HsmDeviceManagement.CreateHsmDeviceAsync(request);
            _busy = false;

            if (success) { MudDialog.Close(DialogResult.Ok(true)); return; }
            _error = error ?? "Gagal menambahkan HSM device.";
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private class FormModel
    {
        public string HsmName { get; set; } = string.Empty;
        public short? Priority { get; set; }
        public string Protocol { get; set; } = "2";
        public bool UseScheme { get; set; } = true;
        public short? MessageHeader { get; set; }
        public string RemoteIp { get; set; } = string.Empty;
        public string RemotePort { get; set; } = string.Empty;
    }
}
