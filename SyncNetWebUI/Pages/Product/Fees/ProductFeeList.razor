@page "/product-fee"
@attribute [Authorize]
@inject ProductFeeManagementService FeeManagement
@inject ProductManagementService ProductManagement
@inject MerchantManagementService MerchantManagement
@inject SubMerchantManagementService SubMerchantManagement
@inject MerchantGroupManagementService MerchantGroupManagement
@inject SubMerchantGroupManagementService SubMerchantGroupManagement
@inject SessionState Session
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Product Fees</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">Product Fees</MudText>
<MudText Typo="Typo.body1" Style="opacity:.65" Class="mb-6">Product > Fees > Product Fees.</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
        <MudTextField T="string" @bind-Value="_filter" Label="Cari product / group" Immediate="true"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      OnKeyDown="OnSearchKeyDown" Class="flex-grow-1" Style="max-width:320px;" />
        <MudStack Row="true" Spacing="2">
            <MudIconButton Icon="@Icons.Material.Filled.Search" OnClick="LoadAsync" title="Cari" />
            @if (Session.UserManagementPermissions.CanAdd)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenCreateDialog">Tambah Product Fee</MudButton>
            }
        </MudStack>
    </MudStack>
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Class="mb-4" />
}
else if (_error != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}
else
{
    <MudTable Items="_items" Hover="true" Dense="true" Elevation="1" @bind-RowsPerPage="_rowsPerPage">
        <HeaderContent>
            <MudTh>Product</MudTh>
            <MudTh>Group</MudTh>
            <MudTh>Sub Group</MudTh>
            <MudTh>Fee Type</MudTh>
            <MudTh>Total Fee</MudTh>
            <MudTh>Merchant Fee</MudTh>
            <MudTh>Sub Merchant Fee</MudTh>
            <MudTh>Switch Fee</MudTh>
            <MudTh>Aksi</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Product">@context.ProductId — @context.ProductName</MudTd>
            <MudTd DataLabel="Group">@context.GroupName</MudTd>
            <MudTd DataLabel="Sub Group">@context.SubgroupName</MudTd>
            <MudTd DataLabel="Fee Type">@(context.FeeType == "0" ? "Fixed" : "Percent")</MudTd>
            @if (context.FeeType == "0")
            {
                <MudTd DataLabel="Total Fee">@context.FixedFee?.ToString("N0")</MudTd>
                <MudTd DataLabel="Merchant Fee">@context.FixedFeeAcq?.ToString("N0")</MudTd>
                <MudTd DataLabel="Sub Merchant Fee">@context.FixedFeeIss?.ToString("N0")</MudTd>
                <MudTd DataLabel="Switch Fee">@context.FixedFeeSwt?.ToString("N0")</MudTd>
            }
            else
            {
                <MudTd DataLabel="Total Fee">@(context.PercentFee?.ToString("N2"))%</MudTd>
                <MudTd DataLabel="Merchant Fee">@(context.PercentFeeAcq?.ToString("N2"))%</MudTd>
                <MudTd DataLabel="Sub Merchant Fee">@(context.PercentFeeIss?.ToString("N2"))%</MudTd>
                <MudTd DataLabel="Switch Fee">@(context.PercentFeeSwt?.ToString("N2"))%</MudTd>
            }
            <MudTd DataLabel="Aksi">
                @if (Session.UserManagementPermissions.CanEdit)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                   OnClick="@(() => OpenEditDialog(context))" title="Edit" />
                }
                @if (Session.UserManagementPermissions.CanDelete)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                   OnClick="@(() => ConfirmDeleteAsync(context))" title="Hapus" />
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Style="opacity:.65">Tidak ada product fee ditemukan.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 25, 50 }" />
        </PagerContent>
    </MudTable>
}

@code {
    private List<ProductFeeDto> _items = new();
    private List<LookupItemDto> _products = new();
    private List<LookupItemDto> _merchants = new();
    private List<SubMerchantDto> _submerchants = new();
    private List<LookupItemDto> _groups = new();
    private List<LookupItemDto> _subgroups = new();
    private string _filter = string.Empty;
    private bool _loading = true;
    private string? _error;
    private int _rowsPerPage = 10;
    private static readonly DialogOptions WideDialogOptions = new() { MaxWidth = MaxWidth.Large, FullWidth = true };

    protected override async Task OnInitializedAsync()
    {
        var products = await ProductManagement.GetProductsAsync();
        _products = products?.Select(p => new LookupItemDto(p.ProductCode, p.ProductName ?? p.ProductCode)).ToList() ?? new();

        var merchants = await MerchantManagement.GetMerchantsAsync();
        _merchants = merchants?.Select(m => new LookupItemDto(m.MerchantId, m.Name ?? m.MerchantId)).ToList() ?? new();

        var submerchants = await SubMerchantManagement.GetSubMerchantsAsync();
        _submerchants = submerchants ?? new();

        var groups = await MerchantGroupManagement.GetGroupsAsync();
        _groups = groups?.Select(g => new LookupItemDto(g.GroupName, g.GroupName)).ToList() ?? new();

        var subgroups = await SubMerchantGroupManagement.GetGroupsAsync();
        _subgroups = subgroups?.Select(g => new LookupItemDto(g.GroupName, g.GroupName)).ToList() ?? new();

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        var result = await FeeManagement.GetFeesAsync(_filter);
        if (result == null)
        {
            _error = "Gagal memuat daftar product fee.";
            _items = new();
        }
        else
        {
            _items = result;
        }

        _loading = false;
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadAsync();
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<ProductFeeFormDialog>
        {
            { x => x.IsEdit, false },
            { x => x.Products, _products },
            { x => x.Merchants, _merchants },
            { x => x.Submerchants, _submerchants },
            { x => x.Groups, _groups },
            { x => x.Subgroups, _subgroups }
        };
        var dialog = await DialogService.ShowAsync<ProductFeeFormDialog>("Tambah Product Fee", parameters, WideDialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Snackbar.Add("Product fee berhasil ditambahkan.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task OpenEditDialog(ProductFeeDto item)
    {
        var parameters = new DialogParameters<ProductFeeFormDialog>
        {
            { x => x.IsEdit, true },
            { x => x.Item, item }
        };
        var dialog = await DialogService.ShowAsync<ProductFeeFormDialog>("Edit Product Fee", parameters, WideDialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Snackbar.Add("Perubahan product fee berhasil disimpan.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task ConfirmDeleteAsync(ProductFeeDto item)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Hapus Product Fee",
            $"Yakin ingin menghapus product fee untuk '{item.ProductId}'? Tindakan ini tidak bisa dibatalkan.",
            yesText: "Hapus", cancelText: "Batal");

        if (confirmed != true) return;

        var (success, error) = await FeeManagement.DeleteFeeAsync(item.Id);
        if (success)
        {
            Snackbar.Add("Product fee berhasil dihapus.", Severity.Success);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(error ?? "Gagal menghapus product fee.", Severity.Error);
        }
    }
}
