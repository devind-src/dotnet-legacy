@page "/mon-terminal"
@attribute [Authorize]
@using SyncNetApi.Dtos.RouteMargins
@using SyncNetWasm.Common
@inject MonitoringManagementService Monitoring

<PageTitle>Terminal</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">Terminal</MudText>
<MudText Typo="Typo.body1" Style="opacity:.65" Class="mb-6">Monitoring > Realtime > Terminal.</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
        <MudTextField T="string" @bind-Value="_filter" Label="Cari terminal" Immediate="true"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      OnKeyDown="OnSearchKeyDown" Class="flex-grow-1" Style="max-width:320px;" />
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync" title="Refresh" />
    </MudStack>
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Class="mb-4" />
}
else if (_error != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}
else
{
    <MudTable Items="_items" Hover="true" Dense="true" Elevation="1" @bind-RowsPerPage="_rowsPerPage" T="TerminalMonitorDto">
        <HeaderContent>
            <MudTh></MudTh>
            <MudTh>Terminal ID</MudTh>
            <MudTh>Merchant ID</MudTh>
            <MudTh>Location</MudTh>
            <MudTh>Brand</MudTh>
            <MudTh>Type</MudTh>
            <MudTh>Serial Number</MudTh>
            <MudTh>Status</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel=""><MudIcon Icon="@Icons.Material.Filled.Circle" Size="Size.Small" Color="@(context.Status == "1" ? Color.Success : Color.Error)" /></MudTd>
            <MudTd DataLabel="Terminal ID">@context.TermId</MudTd>
            <MudTd DataLabel="Merchant ID">@context.MerchantId</MudTd>
            <MudTd DataLabel="Location">@context.Location</MudTd>
            <MudTd DataLabel="Brand">@context.Brand</MudTd>
            <MudTd DataLabel="Type">@context.Type</MudTd>
            <MudTd DataLabel="Serial Number">@context.SerialNumber</MudTd>
            <MudTd DataLabel="Status">@(context.Status == "1" ? "Active" : "Not Active")</MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Style="opacity:.65">Tidak ada terminal ditemukan.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 25, 50 }" />
        </PagerContent>
    </MudTable>
}

@code {
    private List<TerminalMonitorDto> _items = new();
    private string _filter = string.Empty;
    private bool _loading = true;
    private string? _error;
    private int _rowsPerPage = 10;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        var result = await Monitoring.GetTerminalsAsync(_filter);
        if (result == null)
        {
            _error = "Gagal memuat daftar terminal.";
            _items = new();
        }
        else
        {
            _items = result;
        }

        _loading = false;
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadAsync();
    }
}
