@page "/cashout/account/qris"
@attribute [Authorize]
@inject AgentBankManagementService AgentBankManagement
@inject BankManagementService BankManagement
@inject SessionState Session
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Cashout Account QRIS Static</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">Cashout Account QRIS Static</MudText>
<MudText Typo="Typo.body1" Style="opacity:.65" Class="mb-6">Cashout Account &gt; QRIS Static.</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
        <MudTextField T="string" @bind-Value="_filter" Label="Cari NMID / bank" Immediate="true"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      OnKeyDown="OnSearchKeyDown" Class="flex-grow-1" Style="max-width:320px;" />
        <MudStack Row="true" Spacing="2">
            <MudIconButton Icon="@Icons.Material.Filled.Search" OnClick="LoadAsync" title="Cari" />
            @if (Session.UserManagementPermissions.CanAdd)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenCreateDialog">Tambah QRIS Static</MudButton>
            }
        </MudStack>
    </MudStack>
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Class="mb-4" />
}
else if (_error != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}
else
{
    <MudTable Items="_items" Hover="true" Dense="true" Elevation="1" @bind-RowsPerPage="_rowsPerPage">
        <HeaderContent>
            <MudTh>NMID</MudTh>
            <MudTh>Bank Name</MudTh>
            <MudTh>Bank Code</MudTh>
            <MudTh>Account Number</MudTh>
            <MudTh>Account Name</MudTh>
            <MudTh>Aksi</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="NMID">@context.Nmid</MudTd>
            <MudTd DataLabel="Bank Name">@context.BankName</MudTd>
            <MudTd DataLabel="Bank Code">@context.BankCode</MudTd>
            <MudTd DataLabel="Account Number">@context.AccNumber</MudTd>
            <MudTd DataLabel="Account Name">@context.AccName</MudTd>
            <MudTd DataLabel="Aksi">
                @if (Session.UserManagementPermissions.CanEdit)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                   OnClick="@(() => OpenEditDialog(context))" title="Edit" />
                }
                @if (Session.UserManagementPermissions.CanDelete)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                   OnClick="@(() => ConfirmDeleteAsync(context))" title="Hapus" />
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Style="opacity:.65">Tidak ada QRIS static account ditemukan.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 25, 50 }" />
        </PagerContent>
    </MudTable>
}

@code {
    private List<AgentBankDto> _items = new();
    private List<BankDto> _banks = new();
    private string _filter = string.Empty;
    private bool _loading = true;
    private string? _error;
    private int _rowsPerPage = 10;
    private static readonly DialogOptions NarrowDialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true };

    protected override async Task OnInitializedAsync()
    {
        _banks = await BankManagement.GetBanksAsync() ?? new();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        var result = await AgentBankManagement.GetRecordsAsync(_filter);
        if (result == null)
        {
            _error = "Gagal memuat daftar QRIS static account.";
            _items = new();
        }
        else
        {
            _items = result;
        }

        _loading = false;
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadAsync();
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<AgentBankFormDialog>
        {
            { x => x.IsEdit, false },
            { x => x.Banks, _banks }
        };
        var dialog = await DialogService.ShowAsync<AgentBankFormDialog>("Tambah QRIS Static", parameters, NarrowDialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Snackbar.Add("QRIS static account berhasil ditambahkan.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task OpenEditDialog(AgentBankDto item)
    {
        var parameters = new DialogParameters<AgentBankFormDialog>
        {
            { x => x.IsEdit, true },
            { x => x.Item, item },
            { x => x.Banks, _banks }
        };
        var dialog = await DialogService.ShowAsync<AgentBankFormDialog>("Edit QRIS Static", parameters, NarrowDialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Snackbar.Add("Perubahan QRIS static account berhasil disimpan.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task ConfirmDeleteAsync(AgentBankDto item)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Hapus QRIS Static",
            $"Yakin ingin menghapus QRIS static account untuk NMID '{item.Nmid}'? Tindakan ini tidak bisa dibatalkan.",
            yesText: "Hapus", cancelText: "Batal");

        if (confirmed != true) return;

        var (success, error) = await AgentBankManagement.DeleteAsync(item.Id);
        if (success)
        {
            Snackbar.Add("QRIS static account berhasil dihapus.", Severity.Success);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(error ?? "Gagal menghapus QRIS static account.", Severity.Error);
        }
    }
}
