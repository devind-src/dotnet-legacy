@page "/job-fee"
@attribute [Authorize]
@inject JobFeeManagementService JobFeeManagement
@inject SessionState Session
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Job Fee</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">Job Fee</MudText>
<MudText Typo="Typo.body1" Style="opacity:.65" Class="mb-6">Konfigurasi > Jobs > Job Fee.</MudText>

<MudAlert Severity="Severity.Info" Class="mb-4" Dense="true">
    Data fee diisi lewat upload file CSV (delimiter titik-koma). Setelah dibuat, job fee bersifat
    hanya-baca (lihat detail atau hapus) — tidak bisa diedit langsung.
</MudAlert>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
        <MudTextField T="string" @bind-Value="_filter" Label="Cari job desc" Immediate="true"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      OnKeyDown="OnSearchKeyDown" Class="flex-grow-1" Style="max-width:320px;" />
        <MudStack Row="true" Spacing="2">
            <MudIconButton Icon="@Icons.Material.Filled.Search" OnClick="LoadAsync" title="Cari" />
            @if (Session.UserManagementPermissions.CanAdd)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.UploadFile"
                           OnClick="OpenCreateDialog">Upload Job Fee</MudButton>
            }
        </MudStack>
    </MudStack>
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Class="mb-4" />
}
else if (_error != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}
else
{
    <MudTable Items="_items" Hover="true" Dense="true" Elevation="1" @bind-RowsPerPage="_rowsPerPage">
        <HeaderContent>
            <MudTh>Job Desc</MudTh>
            <MudTh>Scheduled At</MudTh>
            <MudTh>Jumlah Baris</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Aksi</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Job Desc">@context.JobDesc</MudTd>
            <MudTd DataLabel="Scheduled At">@context.ScheduledAt</MudTd>
            <MudTd DataLabel="Jumlah Baris">@context.DetailCount</MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Size="Size.Small" Color="@(context.IsDone ? Color.Success : Color.Info)">
                    @(context.IsDone ? "Done" : "Scheduled")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Aksi">
                <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small"
                               OnClick="@(() => OpenDetailDialog(context))" title="Lihat Detail" />
                @if (Session.UserManagementPermissions.CanDelete)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                   OnClick="@(() => ConfirmDeleteAsync(context))" title="Hapus" />
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Style="opacity:.65">Tidak ada job fee ditemukan.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 25, 50 }" />
        </PagerContent>
    </MudTable>
}

@code {
    private List<JobFeeDto> _items = new();
    private string _filter = string.Empty;
    private bool _loading = true;
    private string? _error;
    private int _rowsPerPage = 10;
    private static readonly DialogOptions WideDialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true };
    private static readonly DialogOptions LargeDialogOptions = new() { MaxWidth = MaxWidth.Large, FullWidth = true };

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        var result = await JobFeeManagement.GetJobFeesAsync(_filter);
        if (result == null)
        {
            _error = "Gagal memuat daftar job fee.";
            _items = new();
        }
        else
        {
            _items = result;
        }

        _loading = false;
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadAsync();
    }

    private async Task OpenCreateDialog()
    {
        var dialog = await DialogService.ShowAsync<JobFeeCreateDialog>("Upload Job Fee", WideDialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Snackbar.Add("Job fee berhasil ditambahkan.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task OpenDetailDialog(JobFeeDto item)
    {
        var parameters = new DialogParameters<JobFeeDetailDialog> { { x => x.JobFee, item } };
        await DialogService.ShowAsync<JobFeeDetailDialog>("Detail Job Fee", parameters, LargeDialogOptions);
    }

    private async Task ConfirmDeleteAsync(JobFeeDto item)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Hapus Job Fee",
            $"Yakin ingin menghapus job fee '{item.JobDesc}' beserta {item.DetailCount} baris detail-nya? Tindakan ini tidak bisa dibatalkan.",
            yesText: "Hapus", cancelText: "Batal");

        if (confirmed != true) return;

        var (success, error) = await JobFeeManagement.DeleteJobFeeAsync(item.Id);
        if (success)
        {
            Snackbar.Add("Job fee berhasil dihapus.", Severity.Success);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(error ?? "Gagal menghapus job fee.", Severity.Error);
        }
    }
}
