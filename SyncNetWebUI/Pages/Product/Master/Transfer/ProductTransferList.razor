@page "/product/master/transfer"
@attribute [Authorize]
@inject ProductTransferManagementService TransferManagement
@inject NodeManagementService NodeManagement
@inject SessionState Session
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Transfer</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">Transfer</MudText>
<MudText Typo="Typo.body1" Style="opacity:.65" Class="mb-6">Product > Master > Transfer.</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
        <MudTextField T="string" @bind-Value="_filter" Label="Cari node / bank" Immediate="true"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      OnKeyDown="OnSearchKeyDown" Class="flex-grow-1" Style="max-width:320px;" />
        <MudStack Row="true" Spacing="2">
            <MudIconButton Icon="@Icons.Material.Filled.Search" OnClick="LoadAsync" title="Cari" />
            @if (Session.UserManagementPermissions.CanAdd)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenCreateDialog">Tambah Transfer</MudButton>
            }
        </MudStack>
    </MudStack>
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Class="mb-4" />
}
else if (_error != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}
else
{
    <MudTable Items="_items" Hover="true" Dense="true" Elevation="1" @bind-RowsPerPage="_rowsPerPage">
        <HeaderContent>
            <MudTh>Node Name</MudTh>
            <MudTh>Bank Code</MudTh>
            <MudTh>Bank Name</MudTh>
            <MudTh>Aksi</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Node Name">@context.Name</MudTd>
            <MudTd DataLabel="Bank Code">@context.BankCode</MudTd>
            <MudTd DataLabel="Bank Name">@context.BankName</MudTd>
            <MudTd DataLabel="Aksi">
                @if (Session.UserManagementPermissions.CanEdit)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                   OnClick="@(() => OpenEditDialog(context))" title="Edit" />
                }
                @if (Session.UserManagementPermissions.CanDelete)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                   OnClick="@(() => ConfirmDeleteAsync(context))" title="Hapus" />
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Style="opacity:.65">Tidak ada transfer ditemukan.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 25, 50 }" />
        </PagerContent>
    </MudTable>
}

@code {
    private List<ProductTransferDto> _items = new();
    private List<NodeDto> _nodes = new();
    private string _filter = string.Empty;
    private bool _loading = true;
    private string? _error;
    private int _rowsPerPage = 10;
    private static readonly DialogOptions WideDialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true };

    protected override async Task OnInitializedAsync()
    {
        var nodes = await NodeManagement.GetNodesAsync();
        _nodes = nodes ?? new();

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        var result = await TransferManagement.GetTransfersAsync(_filter);
        if (result == null)
        {
            _error = "Gagal memuat daftar transfer.";
            _items = new();
        }
        else
        {
            _items = result;
        }

        _loading = false;
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadAsync();
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<ProductTransferFormDialog>
        {
            { x => x.IsEdit, false },
            { x => x.Nodes, _nodes }
        };
        var dialog = await DialogService.ShowAsync<ProductTransferFormDialog>("Tambah Transfer", parameters, WideDialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Snackbar.Add("Transfer berhasil ditambahkan.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task OpenEditDialog(ProductTransferDto item)
    {
        var parameters = new DialogParameters<ProductTransferFormDialog>
        {
            { x => x.IsEdit, true },
            { x => x.Transfer, item },
            { x => x.Nodes, _nodes }
        };
        var dialog = await DialogService.ShowAsync<ProductTransferFormDialog>("Edit Transfer", parameters, WideDialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Snackbar.Add("Perubahan transfer berhasil disimpan.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task ConfirmDeleteAsync(ProductTransferDto item)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Hapus Transfer",
            $"Yakin ingin menghapus transfer '{item.Name}' / '{item.BankCode}'? Tindakan ini tidak bisa dibatalkan.",
            yesText: "Hapus", cancelText: "Batal");

        if (confirmed != true) return;

        var (success, error) = await TransferManagement.DeleteTransferAsync(item.Id);
        if (success)
        {
            Snackbar.Add("Transfer berhasil dihapus.", Severity.Success);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(error ?? "Gagal menghapus transfer.", Severity.Error);
        }
    }
}
