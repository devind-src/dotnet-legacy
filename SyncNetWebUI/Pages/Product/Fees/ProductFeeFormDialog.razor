<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">
                <MudIcon Icon="@Icons.Material.Filled.Payments" />
            </MudAvatar>
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6">@(IsEdit ? "Edit Product Fee" : "Tambah Product Fee")</MudText>
                @if (IsEdit)
                {
                    <MudText Typo="Typo.caption" Style="opacity:.65">@Item?.ProductId</MudText>
                }
            </MudStack>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="_model" Class="px-2 pt-4">
            <MudGrid Spacing="5">
                <MudItem xs="12" sm="6">
                    @if (IsEdit)
                    {
                        <MudTextField T="string" Label="Product" Value="@ProductDisplay" Disabled="true" />
                    }
                    else
                    {
                        <MudAutocomplete T="string" Label="Product" @bind-Value="_model.ProductId"
                                         SearchFunc="SearchProducts" ToStringFunc="FormatProduct" Required="true" RequiredError="Product wajib diisi"
                                         CoerceValue="true" Disabled="_busy" MaxLength="30" />
                    }
                </MudItem>
                <MudItem xs="12" sm="6">
                    @if (IsEdit)
                    {
                        <MudTextField T="string" Label="Merchant" Value="@MerchantDisplay" Disabled="true" />
                    }
                    else
                    {
                        <MudAutocomplete T="string" Label="Merchant (opsional)" @bind-Value="_model.MerchantId"
                                         SearchFunc="SearchMerchants" Clearable="true"
                                         CoerceValue="true" Disabled="_busy" MaxLength="15" />
                    }
                </MudItem>
                <MudItem xs="12" sm="6">
                    @if (IsEdit)
                    {
                        <MudTextField T="string" Label="Sub Merchant" Value="@SubmerchantDisplay" Disabled="true" />
                    }
                    else
                    {
                        <MudAutocomplete T="string" Label="Sub Merchant (opsional)" @bind-Value="_model.SubmerchantId"
                                         SearchFunc="SearchSubmerchants" Clearable="true"
                                         CoerceValue="true" Disabled="_busy" MaxLength="30" />
                    }
                </MudItem>
                <MudItem xs="12" sm="3">
                    @if (IsEdit)
                    {
                        <MudTextField T="string" Label="Group Name" @bind-Value="_model.GroupName" Disabled="true" />
                    }
                    else
                    {
                        <MudAutocomplete T="string" Label="Group Name (opsional)" @bind-Value="_model.GroupName"
                                         SearchFunc="SearchGroups" Clearable="true"
                                         CoerceValue="true" Disabled="_busy" MaxLength="50" />
                    }
                </MudItem>
                <MudItem xs="12" sm="3">
                    @if (IsEdit)
                    {
                        <MudTextField T="string" Label="Sub Group Name" @bind-Value="_model.SubgroupName" Disabled="true" />
                    }
                    else
                    {
                        <MudAutocomplete T="string" Label="Sub Group Name (opsional)" @bind-Value="_model.SubgroupName"
                                         SearchFunc="SearchSubgroups" Clearable="true"
                                         CoerceValue="true" Disabled="_busy" MaxLength="50" />
                    }
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect T="string" Label="Fee Type" @bind-Value="_model.FeeType" Disabled="_busy">
                        <MudSelectItem T="string" Value="@("0")">Fixed</MudSelectItem>
                        <MudSelectItem T="string" Value="@("1")">Percent</MudSelectItem>
                    </MudSelect>
                </MudItem>

                @if (_model.FeeType == "0")
                {
                    <MudItem xs="12" sm="3">
                        <MudNumericField T="int?" Label="Total Fee" @bind-Value="_model.FixedFee" Disabled="_busy" />
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudNumericField T="int?" Label="Fee Merchant" @bind-Value="_model.FixedFeeAcq" Disabled="_busy" />
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudNumericField T="int?" Label="Fee Sub Merchant" @bind-Value="_model.FixedFeeIss" Disabled="_busy" />
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudNumericField T="int?" Label="Fee Switch" @bind-Value="_model.FixedFeeSwt" Disabled="_busy" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Style="opacity:.65">Fee Merchant + Fee Sub Merchant + Fee Switch harus sama dengan Total Fee.</MudText>
                    </MudItem>
                }
                else
                {
                    <MudItem xs="12" sm="3">
                        <MudNumericField T="decimal?" Label="Total Fee (%)" @bind-Value="_model.PercentFee" Disabled="_busy" Format="N2" />
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudNumericField T="decimal?" Label="Fee Merchant (%)" @bind-Value="_model.PercentFeeAcq" Disabled="_busy" Format="N2" />
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudNumericField T="decimal?" Label="Fee Sub Merchant (%)" @bind-Value="_model.PercentFeeIss" Disabled="_busy" Format="N2" />
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudNumericField T="decimal?" Label="Fee Switch (%)" @bind-Value="_model.PercentFeeSwt" Disabled="_busy" Format="N2" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Style="opacity:.65">Fee Merchant + Fee Sub Merchant + Fee Switch (%) harus 100%.</MudText>
                    </MudItem>
                }
            </MudGrid>

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mt-4" Dense="true">@_error</MudAlert>
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_busy">Batal</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Simpan
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Inject] private ProductFeeManagementService FeeManagement { get; set; } = null!;
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public ProductFeeDto? Item { get; set; }
    [Parameter] public List<LookupItemDto> Products { get; set; } = new();
    [Parameter] public List<LookupItemDto> Merchants { get; set; } = new();
    [Parameter] public List<SubMerchantDto> Submerchants { get; set; } = new();
    [Parameter] public List<LookupItemDto> Groups { get; set; } = new();
    [Parameter] public List<LookupItemDto> Subgroups { get; set; } = new();

    private MudForm _form = null!;
    private readonly FormModel _model = new();
    private bool _busy;
    private string? _error;

    private string ProductDisplay => string.IsNullOrEmpty(Item?.ProductId) ? "-" : $"{Item.ProductId} - {Item.ProductName}";
    private string MerchantDisplay => string.IsNullOrEmpty(Item?.MerchantId) ? "-" : $"{Item.MerchantId} - {Item.MerchantName}";
    private string SubmerchantDisplay => string.IsNullOrEmpty(Item?.SubmerchantId) ? "-" : $"{Item.SubmerchantId} - {Item.SubmerchantName}";

    protected override void OnInitialized()
    {
        if (IsEdit && Item != null)
        {
            _model.ProductId = Item.ProductId ?? string.Empty;
            _model.GroupName = Item.GroupName ?? string.Empty;
            _model.SubgroupName = Item.SubgroupName ?? string.Empty;
            _model.MerchantId = Item.MerchantId;
            _model.SubmerchantId = Item.SubmerchantId;
            _model.FeeType = Item.FeeType;
            _model.FixedFee = Item.FixedFee;
            _model.FixedFeeAcq = Item.FixedFeeAcq;
            _model.FixedFeeIss = Item.FixedFeeIss;
            _model.FixedFeeSwt = Item.FixedFeeSwt;
            _model.PercentFee = Item.PercentFee;
            _model.PercentFeeAcq = Item.PercentFeeAcq;
            _model.PercentFeeIss = Item.PercentFeeIss;
            _model.PercentFeeSwt = Item.PercentFeeSwt;
        }
    }

    private Task<IEnumerable<string>> SearchProducts(string? value, CancellationToken ct) => SearchLookup(Products, value);

    private string? FormatProduct(string? code)
    {
        if (string.IsNullOrEmpty(code)) return code;
        var match = Products.FirstOrDefault(p => p.Key == code);
        return match == null ? code : $"{match.Key} — {match.Value}";
    }

    private Task<IEnumerable<string>> SearchMerchants(string? value, CancellationToken ct) => SearchLookup(Merchants, value);
    private Task<IEnumerable<string>> SearchGroups(string? value, CancellationToken ct) => SearchLookup(Groups, value);
    private Task<IEnumerable<string>> SearchSubgroups(string? value, CancellationToken ct) => SearchLookup(Subgroups, value);

    private static Task<IEnumerable<string>> SearchLookup(List<LookupItemDto> items, string? value)
    {
        var matches = string.IsNullOrWhiteSpace(value)
            ? items.Select(i => i.Key)
            : items.Where(i => i.Key.Contains(value, StringComparison.OrdinalIgnoreCase)
                                || i.Value.Contains(value, StringComparison.OrdinalIgnoreCase))
                   .Select(i => i.Key);
        return Task.FromResult(matches);
    }

    // Mirrors legacy FilterSubMerchant — suggestions are scoped to the currently selected
    // Merchant (matches legacy's dynamic SubMerchantGetList(merchantId) reload on change).
    private Task<IEnumerable<string>> SearchSubmerchants(string? value, CancellationToken ct)
    {
        var scoped = string.IsNullOrEmpty(_model.MerchantId)
            ? Submerchants
            : Submerchants.Where(s => s.MerchantId == _model.MerchantId).ToList();

        var matches = string.IsNullOrWhiteSpace(value)
            ? scoped.Select(s => s.SubMerchantId)
            : scoped.Where(s => s.SubMerchantId.Contains(value, StringComparison.OrdinalIgnoreCase)
                                 || (s.Name ?? "").Contains(value, StringComparison.OrdinalIgnoreCase))
                    .Select(s => s.SubMerchantId);
        return Task.FromResult(matches);
    }

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        _busy = true;
        _error = null;

        if (IsEdit && Item != null)
        {
            var request = new UpdateProductFeeRequest
            {
                FeeType = _model.FeeType,
                FixedFee = _model.FixedFee,
                FixedFeeAcq = _model.FixedFeeAcq,
                FixedFeeIss = _model.FixedFeeIss,
                FixedFeeSwt = _model.FixedFeeSwt,
                PercentFee = _model.PercentFee,
                PercentFeeAcq = _model.PercentFeeAcq,
                PercentFeeIss = _model.PercentFeeIss,
                PercentFeeSwt = _model.PercentFeeSwt
            };
            var (success, error) = await FeeManagement.UpdateFeeAsync(Item.Id, request);
            _busy = false;

            if (success) { MudDialog.Close(DialogResult.Ok(true)); return; }
            _error = error ?? "Gagal menyimpan perubahan.";
        }
        else
        {
            var request = new CreateProductFeeRequest
            {
                ProductId = _model.ProductId,
                MerchantId = _model.MerchantId,
                SubmerchantId = _model.SubmerchantId,
                GroupName = _model.GroupName,
                SubgroupName = _model.SubgroupName,
                FeeType = _model.FeeType,
                FixedFee = _model.FixedFee,
                FixedFeeAcq = _model.FixedFeeAcq,
                FixedFeeIss = _model.FixedFeeIss,
                FixedFeeSwt = _model.FixedFeeSwt,
                PercentFee = _model.PercentFee,
                PercentFeeAcq = _model.PercentFeeAcq,
                PercentFeeIss = _model.PercentFeeIss,
                PercentFeeSwt = _model.PercentFeeSwt
            };
            var (success, _, error) = await FeeManagement.CreateFeeAsync(request);
            _busy = false;

            if (success) { MudDialog.Close(DialogResult.Ok(true)); return; }
            _error = error ?? "Gagal menambahkan product fee.";
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private class FormModel
    {
        public string ProductId { get; set; } = string.Empty;
        public string? MerchantId { get; set; }
        public string? SubmerchantId { get; set; }
        public string GroupName { get; set; } = string.Empty;
        public string SubgroupName { get; set; } = string.Empty;
        public string FeeType { get; set; } = "0";
        public int? FixedFee { get; set; }
        public int? FixedFeeAcq { get; set; }
        public int? FixedFeeIss { get; set; }
        public int? FixedFeeSwt { get; set; }
        public decimal? PercentFee { get; set; }
        public decimal? PercentFeeAcq { get; set; }
        public decimal? PercentFeeIss { get; set; }
        public decimal? PercentFeeSwt { get; set; }
    }
}
