@page "/product-supplier-prices"
@attribute [Authorize]
@inject ProductSupplierPriceManagementService PriceManagement
@inject NodeManagementService NodeManagement
@inject LookupService Lookups
@inject SessionState Session
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Supplier Prices</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">Supplier Prices</MudText>
<MudText Typo="Typo.body1" Style="opacity:.65" Class="mb-6">Product > Prices > Supplier Prices (untuk produk topup).</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
        <MudTextField T="string" @bind-Value="_filter" Label="Cari supplier / product" Immediate="true"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      OnKeyDown="OnSearchKeyDown" Class="flex-grow-1" Style="max-width:320px;" />
        <MudStack Row="true" Spacing="2">
            <MudIconButton Icon="@Icons.Material.Filled.Search" OnClick="LoadAsync" title="Cari" />
            @if (Session.UserManagementPermissions.CanAdd)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenCreateDialog">Tambah Supplier Price</MudButton>
            }
        </MudStack>
    </MudStack>
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Class="mb-4" />
}
else if (_error != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}
else
{
    <MudTable Items="_items" Hover="true" Dense="true" Elevation="1" @bind-RowsPerPage="_rowsPerPage">
        <HeaderContent>
            <MudTh>Supplier</MudTh>
            <MudTh>Product</MudTh>
            <MudTh>Denom</MudTh>
            <MudTh>Harga Beli</MudTh>
            <MudTh>Harga Jual</MudTh>
            <MudTh>Margin</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Aksi</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Supplier">@context.SupplierId</MudTd>
            <MudTd DataLabel="Product">@context.BillerCode — @context.ProductName</MudTd>
            <MudTd DataLabel="Denom">@context.Denom?.ToString("N0")</MudTd>
            <MudTd DataLabel="Harga Beli">@context.HargaBeli?.ToString("N0")</MudTd>
            <MudTd DataLabel="Harga Jual">@context.HargaJual?.ToString("N0")</MudTd>
            <MudTd DataLabel="Margin">@context.Margin?.ToString("N0")</MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Size="Size.Small" Color="@(context.Active ? Color.Success : Color.Default)">
                    @(context.Active ? "Aktif" : "Nonaktif")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Aksi">
                @if (Session.UserManagementPermissions.CanEdit)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                   OnClick="@(() => OpenEditDialog(context))" title="Edit" />
                }
                @if (Session.UserManagementPermissions.CanDelete)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                   OnClick="@(() => ConfirmDeleteAsync(context))" title="Hapus" />
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Style="opacity:.65">Tidak ada supplier price ditemukan.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 25, 50 }" />
        </PagerContent>
    </MudTable>
}

@code {
    private List<ProductSupplierPriceDto> _items = new();
    private List<NodeDto> _nodes = new();
    private List<LookupItemDto> _topupProducts = new();
    private string _filter = string.Empty;
    private bool _loading = true;
    private string? _error;
    private int _rowsPerPage = 10;
    private static readonly DialogOptions WideDialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true };

    protected override async Task OnInitializedAsync()
    {
        var nodes = await NodeManagement.GetNodesAsync();
        _nodes = nodes ?? new();

        var topup = await Lookups.GetTopupProductsAsync();
        _topupProducts = topup ?? new();

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        var result = await PriceManagement.GetPricesAsync(_filter);
        if (result == null)
        {
            _error = "Gagal memuat daftar supplier price.";
            _items = new();
        }
        else
        {
            _items = result;
        }

        _loading = false;
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadAsync();
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<SupplierPriceFormDialog>
        {
            { x => x.IsEdit, false },
            { x => x.Nodes, _nodes },
            { x => x.TopupProducts, _topupProducts }
        };
        var dialog = await DialogService.ShowAsync<SupplierPriceFormDialog>("Tambah Supplier Price", parameters, WideDialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Snackbar.Add("Supplier price berhasil ditambahkan.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task OpenEditDialog(ProductSupplierPriceDto item)
    {
        var parameters = new DialogParameters<SupplierPriceFormDialog>
        {
            { x => x.IsEdit, true },
            { x => x.Item, item },
            { x => x.Nodes, _nodes },
            { x => x.TopupProducts, _topupProducts }
        };
        var dialog = await DialogService.ShowAsync<SupplierPriceFormDialog>("Edit Supplier Price", parameters, WideDialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Snackbar.Add("Perubahan supplier price berhasil disimpan.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task ConfirmDeleteAsync(ProductSupplierPriceDto item)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Hapus Supplier Price",
            $"Yakin ingin menghapus supplier price '{item.SupplierId} / {item.BillerCode}'? Tindakan ini tidak bisa dibatalkan.",
            yesText: "Hapus", cancelText: "Batal");

        if (confirmed != true) return;

        var (success, error) = await PriceManagement.DeletePriceAsync(item.Id);
        if (success)
        {
            Snackbar.Add("Supplier price berhasil dihapus.", Severity.Success);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(error ?? "Gagal menghapus supplier price.", Severity.Error);
        }
    }
}
