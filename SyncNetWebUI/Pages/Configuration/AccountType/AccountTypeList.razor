@page "/base-account-type"
@attribute [Authorize]
@inject AccountTypeManagementService AccountTypeManagement
@inject SessionState Session
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Account Type</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">Account Type</MudText>
<MudText Typo="Typo.body1" Style="opacity:.65" Class="mb-6">Konfigurasi > Base > Account Type.</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
        <MudTextField T="string" @bind-Value="_filter" Label="Cari account type" Immediate="true"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      OnKeyDown="OnSearchKeyDown" Class="flex-grow-1" Style="max-width:320px;" />
        <MudStack Row="true" Spacing="2">
            <MudIconButton Icon="@Icons.Material.Filled.Search" OnClick="LoadAsync" title="Cari" />
            @if (Session.UserManagementPermissions.CanAdd)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenCreateDialog">Tambah Account Type</MudButton>
            }
        </MudStack>
    </MudStack>
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Class="mb-4" />
}
else if (_error != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}
else
{
    <MudTable Items="_items" Hover="true" Dense="true" Elevation="1" @bind-RowsPerPage="_rowsPerPage">
        <HeaderContent>
            <MudTh>Acct Type</MudTh>
            <MudTh>Name</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Aksi</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Acct Type">@context.AcctType</MudTd>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Size="Size.Small" Color="@(context.Active ? Color.Success : Color.Default)">
                    @(context.Active ? "Aktif" : "Nonaktif")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Aksi">
                @if (Session.UserManagementPermissions.CanEdit)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                   OnClick="@(() => OpenEditDialog(context))" title="Edit" />
                }
                @if (Session.UserManagementPermissions.CanDelete)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                   OnClick="@(() => ConfirmDeleteAsync(context))" title="Hapus" />
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Style="opacity:.65">Tidak ada account type ditemukan.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 25, 50 }" />
        </PagerContent>
    </MudTable>
}

@code {
    private List<AccountTypeDto> _items = new();
    private string _filter = string.Empty;
    private bool _loading = true;
    private string? _error;
    private int _rowsPerPage = 10;
    private static readonly DialogOptions WideDialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true };

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        var result = await AccountTypeManagement.GetAccountTypesAsync(_filter);
        if (result == null)
        {
            _error = "Gagal memuat daftar account type.";
            _items = new();
        }
        else
        {
            _items = result;
        }

        _loading = false;
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadAsync();
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<AccountTypeFormDialog> { { x => x.IsEdit, false } };
        var dialog = await DialogService.ShowAsync<AccountTypeFormDialog>("Tambah Account Type", parameters, WideDialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Snackbar.Add("Account type berhasil ditambahkan.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task OpenEditDialog(AccountTypeDto item)
    {
        var parameters = new DialogParameters<AccountTypeFormDialog>
        {
            { x => x.IsEdit, true },
            { x => x.AccountType, item }
        };
        var dialog = await DialogService.ShowAsync<AccountTypeFormDialog>("Edit Account Type", parameters, WideDialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Snackbar.Add("Perubahan account type berhasil disimpan.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task ConfirmDeleteAsync(AccountTypeDto item)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Hapus Account Type",
            $"Yakin ingin menghapus account type '{item.AcctType}'? Tindakan ini tidak bisa dibatalkan.",
            yesText: "Hapus", cancelText: "Batal");

        if (confirmed != true) return;

        var (success, error) = await AccountTypeManagement.DeleteAccountTypeAsync(item.AcctType);
        if (success)
        {
            Snackbar.Add("Account type berhasil dihapus.", Severity.Success);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(error ?? "Gagal menghapus account type.", Severity.Error);
        }
    }
}
