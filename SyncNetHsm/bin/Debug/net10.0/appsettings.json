{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  "Paths": {
    "Windows": {
      "App": "C:\\SyncNet",
      "Logs": "C:\\SyncNet\\Logs",
      "Traces": "C:\\SyncNet\\Traces"
    },
    "Linux": {
      "App": "/opt/SyncNet",
      "Logs": "/opt/SyncNet/Logs",
      "Traces": "/opt/SyncNet/Traces"
    }
  },

  "HsmService": {
    "UrlListen": "http://localhost:40001",
    "HsmEmulator": true,
    "TraceOn": true
  },

  "HsmDevice": {
    "HsmConnectionMode": "NonPersistent",
    "HsmIpAddress": "localhost",

    "HsmReconnectDelay": 5,
    "HsmPort": 8000,
    "HsmLenHeader": 4,
    "HsmTimeout": 5
  },

  "AllowedHosts": "*"
}
