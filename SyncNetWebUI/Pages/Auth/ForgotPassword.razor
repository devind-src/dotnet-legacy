@page "/forgot-password"
@layout AuthLayout
@attribute [AllowAnonymous]
@inject AuthService AuthService

<AuthShell>
    <MudText Typo="Typo.h5" Style="font-weight:600;" Class="mb-2">Lupa Password</MudText>

    @if (_submitted)
    {
        <MudAlert Severity="Severity.Success" Class="mt-2 mb-4">
            Jika akun ditemukan, link reset password sudah dikirim ke email Anda.
        </MudAlert>
    }
    else
    {
        <MudText Typo="Typo.body2" Style="opacity:.65" Class="mb-6">
            Masukkan username atau email akun Anda.
        </MudText>

        <MudForm @ref="_form" Model="_model">
            <MudTextField T="string" Label="Username atau Email" @bind-Value="_model.Identifier"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.PersonOutline"
                          Required="true" RequiredError="Wajib diisi"
                          Disabled="_busy" Class="mb-4" />

            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large"
                       OnClick="SubmitAsync" Disabled="_busy">
                @if (_busy)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Kirim Link Reset
            </MudButton>
        </MudForm>
    }

    <MudButton Variant="Variant.Text" FullWidth="true" Class="mt-2" Href="/login">
        Kembali ke Login
    </MudButton>
</AuthShell>

@code {
    private MudForm _form = null!;
    private readonly Model _model = new();
    private bool _busy;
    private bool _submitted;

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        _busy = true;
        await AuthService.ForgotPasswordAsync(_model.Identifier);
        _busy = false;

        // Always show the same success state regardless of the actual result — the API
        // itself never reveals whether the identifier matched an account, and the UI must
        // not undo that by branching on success/failure here.
        _submitted = true;
    }

    private class Model
    {
        public string Identifier { get; set; } = string.Empty;
    }
}
