<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">
                <MudIcon Icon="@Icons.Material.Filled.CreditCard" />
            </MudAvatar>
            <MudText Typo="Typo.h6">@(IsEdit ? "Edit Group" : "Tambah Group")</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="_model" Class="px-2 pt-4">
            <MudGrid Spacing="5">
                <MudItem xs="12">
                    <MudTextField T="string" Label="Group Name" @bind-Value="_model.GroupName"
                                  Disabled="_busy || IsEdit" Required="true" RequiredError="Group name wajib diisi" MaxLength="20" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField T="string" Label="Inst ID" @bind-Value="_model.InstId" Disabled="_busy" MaxLength="6" />
                </MudItem>
            </MudGrid>

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mt-4" Dense="true">@_error</MudAlert>
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_busy">Batal</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Simpan
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Inject] private CardGroupManagementService GroupManagement { get; set; } = null!;
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public CardGroupDto? Group { get; set; }

    private MudForm _form = null!;
    private readonly FormModel _model = new();
    private bool _busy;
    private string? _error;

    protected override void OnInitialized()
    {
        if (IsEdit && Group != null)
        {
            _model.GroupId = Group.GroupId;
            _model.GroupName = Group.GroupName ?? string.Empty;
            _model.InstId = Group.InstId;
        }
    }

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        _busy = true;
        _error = null;

        if (IsEdit)
        {
            var (success, error) = await GroupManagement.UpdateGroupAsync(_model.GroupId, new UpdateCardGroupRequest
            {
                InstId = _model.InstId
            });
            _busy = false;

            if (success) { MudDialog.Close(DialogResult.Ok(true)); return; }
            _error = error ?? "Gagal menyimpan perubahan.";
        }
        else
        {
            var request = new CreateCardGroupRequest { GroupName = _model.GroupName, InstId = _model.InstId };
            var (success, _, error) = await GroupManagement.CreateGroupAsync(request);
            _busy = false;

            if (success) { MudDialog.Close(DialogResult.Ok(true)); return; }
            _error = error ?? "Gagal menambahkan group.";
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private class FormModel
    {
        public int GroupId { get; set; }
        public string GroupName { get; set; } = string.Empty;
        public string? InstId { get; set; }
    }
}
