@page "/posbase-terminal"
@attribute [Authorize]
@inject TerminalManagementService TerminalManagement
@inject MerchantManagementService MerchantManagement
@inject SubMerchantManagementService SubMerchantManagement
@inject StoreManagementService StoreManagement
@inject SessionState Session
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Terminal</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">Terminal</MudText>
<MudText Typo="Typo.body1" Style="opacity:.65" Class="mb-6">Kelola data perangkat terminal (EDC).</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
        <MudTextField T="string" @bind-Value="_filter" Label="Cari terminal" Immediate="true"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      OnKeyDown="OnSearchKeyDown" Class="flex-grow-1" Style="max-width:320px;" />
        <MudStack Row="true" Spacing="2">
            <MudIconButton Icon="@Icons.Material.Filled.Search" OnClick="LoadAsync" title="Cari" />
            @if (Session.UserManagementPermissions.CanAdd)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenCreateDialog">Tambah Terminal</MudButton>
            }
        </MudStack>
    </MudStack>
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Class="mb-4" />
}
else if (_error != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}
else
{
    <MudTable Items="_items" Hover="true" Dense="true" Elevation="1" @bind-RowsPerPage="_rowsPerPage">
        <HeaderContent>
            <MudTh>Terminal ID</MudTh>
            <MudTh>Loket</MudTh>
            <MudTh>Merchant</MudTh>
            <MudTh>Serial Number</MudTh>
            <MudTh>Kota</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Aksi</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Terminal ID">@context.TermId</MudTd>
            <MudTd DataLabel="Loket">@context.LoketName</MudTd>
            <MudTd DataLabel="Merchant">@(context.MerchantName ?? context.MerchantId)</MudTd>
            <MudTd DataLabel="Serial Number">@context.SerialNumber</MudTd>
            <MudTd DataLabel="Kota">@context.City</MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Size="Size.Small" Color="@(context.Active ? Color.Success : Color.Default)">
                    @(context.Active ? "Aktif" : "Nonaktif")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Aksi">
                @if (Session.UserManagementPermissions.CanEdit)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                   OnClick="@(() => OpenEditDialog(context))" title="Edit" />
                }
                @if (Session.UserManagementPermissions.CanDelete)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                   OnClick="@(() => ConfirmDeleteAsync(context))" title="Hapus" />
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Style="opacity:.65">Tidak ada terminal ditemukan.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 25, 50 }" />
        </PagerContent>
    </MudTable>
}

@code {
    private List<TerminalDto> _items = new();
    private List<MerchantDto> _merchants = new();
    private List<SubMerchantDto> _subMerchants = new();
    private List<StoreDto> _stores = new();
    private string _filter = string.Empty;
    private bool _loading = true;
    private string? _error;
    private int _rowsPerPage = 10;
    private static readonly DialogOptions WideDialogOptions = new() { MaxWidth = MaxWidth.Large, FullWidth = true };

    protected override async Task OnInitializedAsync()
    {
        _merchants = await MerchantManagement.GetMerchantsAsync() ?? new();
        _subMerchants = await SubMerchantManagement.GetSubMerchantsAsync() ?? new();
        _stores = await StoreManagement.GetStoresAsync() ?? new();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        var result = await TerminalManagement.GetTerminalsAsync(_filter);
        if (result == null)
        {
            _error = "Gagal memuat daftar terminal.";
            _items = new();
        }
        else
        {
            _items = result;
        }

        _loading = false;
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadAsync();
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<TerminalFormDialog>
        {
            { x => x.IsEdit, false },
            { x => x.Merchants, _merchants },
            { x => x.SubMerchants, _subMerchants },
            { x => x.Stores, _stores }
        };
        var dialog = await DialogService.ShowAsync<TerminalFormDialog>("Tambah Terminal", parameters, WideDialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Snackbar.Add("Terminal berhasil ditambahkan.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task OpenEditDialog(TerminalDto terminal)
    {
        var parameters = new DialogParameters<TerminalFormDialog>
        {
            { x => x.IsEdit, true },
            { x => x.Merchants, _merchants },
            { x => x.SubMerchants, _subMerchants },
            { x => x.Stores, _stores },
            { x => x.Terminal, terminal }
        };
        var dialog = await DialogService.ShowAsync<TerminalFormDialog>("Edit Terminal", parameters, WideDialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Snackbar.Add("Perubahan terminal berhasil disimpan.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task ConfirmDeleteAsync(TerminalDto terminal)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Hapus Terminal",
            $"Yakin ingin menghapus terminal '{terminal.TermId}'? Tindakan ini tidak bisa dibatalkan.",
            yesText: "Hapus", cancelText: "Batal");

        if (confirmed != true) return;

        var (success, error) = await TerminalManagement.DeleteTerminalAsync(terminal.TermId);
        if (success)
        {
            Snackbar.Add("Terminal berhasil dihapus.", Severity.Success);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(error ?? "Gagal menghapus terminal.", Severity.Error);
        }
    }
}
