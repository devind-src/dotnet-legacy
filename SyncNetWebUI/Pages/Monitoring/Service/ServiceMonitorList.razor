@page "/mon-services"
@attribute [Authorize]
@using SyncNetApi.Dtos.RouteMargins
@using SyncNetWasm.Common
@inject MonitoringManagementService Monitoring

<PageTitle>Service</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">Interface Services</MudText>
<MudText Typo="Typo.body1" Style="opacity:.65" Class="mb-6">Monitoring > Realtime > Service.</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
        <MudTextField T="string" @bind-Value="_filter" Label="Cari service" Immediate="true"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      OnKeyDown="OnSearchKeyDown" Class="flex-grow-1" Style="max-width:320px;" />
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync" title="Refresh" />
    </MudStack>
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Class="mb-4" />
}
else if (_error != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}
else
{
    <MudTable Items="_items" Hover="true" Dense="true" Elevation="1" @bind-RowsPerPage="_rowsPerPage" T="ServiceMonitorDto">
        <HeaderContent>
            <MudTh></MudTh>
            <MudTh>App Name</MudTh>
            <MudTh>App Type</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Last Updated</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel=""><MudIcon Icon="@Icons.Material.Filled.Circle" Size="Size.Small" Color="@(MonitoringStatus.IsAppRunning(context.Status) ? Color.Success : Color.Error)" /></MudTd>
            <MudTd DataLabel="App Name">@context.AppName</MudTd>
            <MudTd DataLabel="App Type">@MonitoringStatus.AppTypeLabel(context.AppType)</MudTd>
            <MudTd DataLabel="Status">@MonitoringStatus.AppStatusLabel(context.Status)</MudTd>
            <MudTd DataLabel="Last Updated">@(context.LastUpdate?.ToString("yyyy-MM-dd HH:mm:ss") ?? "-")</MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Style="opacity:.65">Tidak ada service ditemukan.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 25, 50 }" />
        </PagerContent>
    </MudTable>
}

@code {
    private List<ServiceMonitorDto> _items = new();
    private string _filter = string.Empty;
    private bool _loading = true;
    private string? _error;
    private int _rowsPerPage = 10;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        var result = await Monitoring.GetServicesAsync(_filter);
        if (result == null)
        {
            _error = "Gagal memuat daftar service.";
            _items = new();
        }
        else
        {
            _items = result;
        }

        _loading = false;
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadAsync();
    }
}
